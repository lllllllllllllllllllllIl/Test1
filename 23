local function remote(parent, name)
    return parent and parent:FindFirstChild(name) or nil
end

local function send(svc, name, ...)
    if not aeroReady then return false end
    local args = table.pack(...)
    local wrapper = svc and svc[name]
    if type(wrapper) == "table" and type(wrapper.Fire) == "function" then
        local ok = pcall(function() wrapper:Fire(table.unpack(args, 1, args.n)) end)
        if ok then return true end
    end
    local r = remote(InputSvc, name)
    if r then
        return pcall(function() r:FireServer(table.unpack(args, 1, args.n)) end)
    end
    return false
end

