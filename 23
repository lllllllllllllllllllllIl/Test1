    "CloseFade","CloseShot","FadeAway","Floater","InsideHandLayup",
    "MovingShot","PostFade","PostHook","ReverseLayup","SpinHook",
    "SpinPostFade","StepPostFade","UnderRimCloseShot",
}

local function applyAnimOverride()
    local pkt = myPkt()
    if not pkt then return end
    -- JumpShot override
    if S.animJumpShot ~= "None" and S.animJumpShot ~= "" then
        pcall(function()
            if pkt.model then pkt.model:SetAttribute("BaseAnimation", S.animJumpShot) end
            setAttr(pkt, "BaseAnimation", S.animJumpShot)
        end)
