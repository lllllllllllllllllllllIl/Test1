-- Match / queue watcher. InGame is the authoritative "on the floor" flag; a
-- true -> false edge with a remembered match means the game is over, so the
-- stats go out and the queue teleport fires once.
-- Quarter watcher. The live header carries four score cells per team; the
-- current quarter is the highest cell with points in it. When that index moves
-- up, the quarter just finished and its numbers go out while play continues.
function recQuarterTick(now)
    if not S.recMatchSeen then return end
    if not recStatsRead() then return end
    local cur = 0
    for i = 1, 4 do
        if (S.quarterHome[i] or 0) > 0 or (S.quarterAway[i] or 0) > 0 then cur = i end
    end
    if cur > (S.quarterSeen or 0) then
        local ended = (S.quarterSeen or 0)
        S.quarterSeen = cur
        if ended >= 1 and ended <= 4 and not S.quarterSent[ended]
            and S.webhookOn and S.webhookQuarters then
            S.quarterSent[ended] = true
            task.spawn(sendQuarterWebhook, ended)
        end
    end
end

function recMatchTick(pkt, now)
    recQuarterTick(now)
    local inGame = pkt and pktAttr(pkt, "InGame") == true
    if inGame then
        if not S.recMatchSeen then
            S.recMatchSeen = true
            S.recMatchEndAt = nil
            recResetStats()
            S.quarterSeen = 0
            S.quarterSent = {}
            S.quarterHome = {}
            S.quarterAway = {}
        end
        return
    end
    if not S.recMatchSeen then return end
    if not S.recMatchEndAt then
        S.recMatchEndAt = now
        -- The final dump waits a beat: the statsheet and the grade panel are
        -- written after InGame flips, so reading them on the same frame would
        -- post zeros.
        if S.webhookOn and S.webhookOnEnd then
            task.delay(2.5, function()
                task.spawn(sendMatchWebhook, "final", 5763719)
            end)
        end
    end
    if not S.recAutoQueue then return end
    if now - S.recMatchEndAt < (S.recAutoQueueDelay or 4) then return end
    if now < (S.recQueueCooldown or 0) then return end
    if game.PlaceId == S.recQueuePlaceId then
        S.recMatchSeen = false
        return
    end
    S.recQueueCooldown = now + 20
    S.recMatchSeen = false
    S.recMatchEndAt = nil
    notify("REC", "game over - back to the queue")
    joinRecQueue()
end

