local lastRelease = 0

local function doMeterRelease()
    local now = os.clock()
    if now - lastRelease < 0.08 then return end
    lastRelease = now
    local ShootR = remote(InputSvc, "Shoot")
    if ShootR then
        pcall(function() ShootR:FireServer({ Shoot = false }) end)
    else
        send(InputS, "Shoot", { Shoot = false })
    end
end

local function setupMeterWatch(char)
    if not char then return end
    local conn
    conn = char:GetAttributeChangedSignal("meterOffset"):Connect(function()
        if not Toggles.AutoTime or not Toggles.AutoTime.Value then return end
        local off = char:GetAttribute("meterOffset")
        if typeof(off) ~= "Vector2" then return end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")

        if hrp and hrp:FindFirstChild("VerticalMeter") and hrp.VerticalMeter.Enabled then
            if off.Y <= -1.319 then doMeterRelease() end
        elseif hrp and hrp:FindFirstChild("BatMeter") and hrp.BatMeter.Enabled then
            if off.Y <= -0.9067 then doMeterRelease() end
        elseif hrp and hrp:FindFirstChild("RocketMeter") and hrp.RocketMeter.Enabled then
            if off.Y <= -0.87 then doMeterRelease() end
        elseif head and head:FindFirstChild("HoopMeter") and head.HoopMeter.Enabled then
            if off.Y >= 0.91 then doMeterRelease() end
        elseif head and head:FindFirstChild("RobloxMeter") and head.RobloxMeter.Enabled then
            if off.X >= 0.822 then doMeterRelease() end
        else
            if off.Y <= -0.9 then doMeterRelease() end
        end
    end)
    track(conn)
end

