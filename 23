        accItemDropdown:SetValues(list)
        accItemDropdown:SetValue(list[1] or "None", true)
    end
    S.accItem = list[1] or "None"
    Library:Notify({
        Title = "Cosmetic",
        Description = "Catalog refreshed",
        Time = 2
    })
end)

