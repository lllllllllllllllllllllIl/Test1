local function pktRoot(pkt)
    if not pkt then return nil end
    local j = pkt.joints
    if j and j.HumanoidRootPart then return j.HumanoidRootPart.object end
    return pkt.HumanoidRootPart
end

local function pktAttr(pkt, name)
    if not pkt or type(pkt.attributes) ~= "table" then return nil end
    return pkt.attributes[name]
end

local function pktHasBall(pkt)
    local b = pktAttr(pkt, "Basketball")
    return b ~= nil and b ~= false
end

-- Character:GetAttribute reads the packet mirror, so this is the write path
-- for anything the movement / animation controllers consume.
local function setAttr(pkt, name, value)
    if not pkt then return end
    if type(pkt.attributes) == "table" then pkt.attributes[name] = value end
    if pkt.model then pcall(function() pkt.model:SetAttribute(name, value) end) end
end

-- The exact name the server wants in Pass.Player. The game's own Passing
-- controller sends `Player = Teammates[i].model.Name`, so the model name wins;
-- fall back to the Characters controller key if the model is gone.
local function pktName(pkt)
    if not pkt then return nil end
    if pkt.model and pkt.model.Name and pkt.model.Name ~= "" then return pkt.model.Name end
    if CharsCtrl then
        local ok, models = pcall(function() return CharsCtrl:Get() end)
        if ok and type(models) == "table" then
            for k, v in pairs(models) do
                if v == pkt then return k end
            end
        end
    end
    return nil
end

local function allPackets()
    local out = {}
    if not CharsCtrl then return out end
    local models = CharsCtrl:Get()
    if type(models) ~= "table" then return out end
    for _, pkt in pairs(models) do
        if pkt and pkt.model then out[#out + 1] = pkt end
    end
    return out
end

local function myPkt()
    if not CharsCtrl then return nil end
    local ok, pkt = pcall(function() return CharsCtrl:GetFromString(me.Name) end)
    if ok then return pkt end
    return nil
end

local function myRoot()
    return pktRoot(myPkt())
end

local function hasBall()
    return pktHasBall(myPkt())
end

local function myTeam()
    local t = pktAttr(myPkt(), "Team")
    if type(t) == "number" then return t end
    return 0
end

local function myGoal()
    local g = pktAttr(myPkt(), "Goal")
    if typeof(g) == "Instance" then return g end
    return nil
end

local function goalPosition()
    local g = myGoal()
    if g and g:IsA("BasePart") then return g.Position end
    local root = myRoot()
    if root and HoopsCtrl and HoopsCtrl.FindClosestGoal then
        local ok, h = pcall(function() return HoopsCtrl:FindClosestGoal(root.Position) end)
        if ok and h then
            if typeof(h) == "Instance" and h:IsA("BasePart") then return h.Position end
            if typeof(h) == "Vector3" then return h end
            if type(h) == "table" and h.Position then return h.Position end
        end
    end
    return nil
end

local function isOpponent(pkt)
    if not pkt then return false end
    local mine = myPkt()
    if pkt == mine then return false end
    local team = myTeam()
    local theirs = pktAttr(pkt, "Team")
    if type(team) == "number" and team ~= 0 then
        return type(theirs) == "number" and theirs ~= team
    end
    return pkt ~= mine
end

local function nearestOpponent(maxDist, needBall)
    local root = myRoot()
    if not root then return nil, math.huge end
    local best, bestD = nil, maxDist or math.huge
    for _, pkt in ipairs(allPackets()) do
        if isOpponent(pkt) then
            if not needBall or pktHasBall(pkt) then
                local r = pktRoot(pkt)
                if r then
                    local d = (r.Position - root.Position).Magnitude
                    if d < bestD then best, bestD = pkt, d end
                end
            end
        end
    end
    return best, bestD
end

local function looseBall(maxDist)
    local root = myRoot()
    if not root then return nil, math.huge end
    local bs = WS:FindFirstChild("Basketballs")
    if not bs then return nil, math.huge end
    local best, bestD = nil, maxDist or math.huge
    for _, b in ipairs(bs:GetDescendants()) do
        if b:IsA("BasePart") then
            local d = (b.Position - root.Position).Magnitude
            if d < bestD then best, bestD = b, d end
        end
    end
    return best, bestD
end

-- ============================================================================
-- MOVEMENT INPUT OVERRIDE
-- Movement:UpdateMoveDirection reads Controls:GetMoveVector(). Assigning that
-- field is silently ignored -- rawset is the only thing that sticks.
-- ============================================================================

local Controls, origGetMoveVector = nil, nil
local moveOverride = nil

do
    local ok, pm = pcall(function() return require(PS:WaitForChild("PlayerModule", 5)) end)
    if ok and pm then
        local ok2, c = pcall(function() return pm:GetControls() end)
        if ok2 and c then
            local orig = rawget(c, "GetMoveVector")
            if type(orig) ~= "function" then orig = c.GetMoveVector end
            if type(orig) == "function" then
                local patched = function(self, ...)
                    if moveOverride then return moveOverride end
                    return orig(self, ...)
                end
                pcall(function() rawset(c, "GetMoveVector", patched) end)
                pcall(function() c.GetMoveVector = patched end)
                local mt = getmetatable(c)
                if type(mt) == "table" and type(mt.__index) == "table" then
                    pcall(function() mt.__index.GetMoveVector = patched end)
                end
                if c.GetMoveVector == patched then
                    Controls, origGetMoveVector = c, orig
                end
            end
        end
    end
end

local function setMoveInput(v) moveOverride = v end

-- Inverse of the PlayerModule mapping: GetMoveVector is camera-relative, with
-- W = -Z and D = +X. Project the world direction onto the camera's flattened
-- right / look vectors. The old version read the rotation matrix and zeroed v2
-- whenever R10 was ~0, which is every level camera - the yaw was thrown away,
-- so "forward" always meant "wherever the camera looks" and every pursuit
-- (guard, farm drive, rebound chase) slid off at an angle.
local function worldToInput(dir)
    local cam = WS.CurrentCamera
    if not cam then return Vector3.new(0, 0, 0) end
    local flat = Vector3.new(dir.X, 0, dir.Z)
    if flat.Magnitude < 1e-4 then return Vector3.new(0, 0, 0) end
    flat = flat.Unit
    local cf = cam.CFrame
    local look = cf.LookVector
    local right = cf.RightVector
    look = Vector3.new(look.X, 0, look.Z)
    right = Vector3.new(right.X, 0, right.Z)
    local lookOk = look.Magnitude > 1e-3
    local rightOk = right.Magnitude > 1e-3
    if not (lookOk or rightOk) then return Vector3.new(0, 0, 0) end
    local x, z
    if lookOk and rightOk then
        x = flat:Dot(right.Unit)
        z = -flat:Dot(look.Unit)
    elseif rightOk then
        -- camera looking straight down: derive forward from right (90 deg yaw)
        local r = right.Unit
        local fwd = Vector3.new(r.Z, 0, -r.X)
        x = flat:Dot(r)
        z = -flat:Dot(fwd)
    else
        local f = look.Unit
        local r = Vector3.new(-f.Z, 0, f.X)
        x = flat:Dot(r)
        z = -flat:Dot(f)
    end
    local m = math.sqrt(x * x + z * z)
    if m > 1 then x, z = x / m, z / m end
    return Vector3.new(x, 0, z)
end

local function moveTowards(pos, weight)
    local root = myRoot()
    if not root then setMoveInput(nil) return end
    local d = pos - root.Position
    d = Vector3.new(d.X, 0, d.Z)
    if d.Magnitude < 0.6 then setMoveInput(nil) return end
    local mag = math.clamp(weight or 1, 0, 1)
    setMoveInput(worldToInput(d.Unit) * mag)
end

local function stopMoving() setMoveInput(nil) end

