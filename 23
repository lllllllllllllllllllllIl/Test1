local function setMoveInput(vec)
    moveOverride = vec
end

local function stopMoving()
    moveOverride = nil
end

local function worldToInput(worldDir)
    local cam = WS.CurrentCamera
    if not cam then return worldDir end
    local cf = cam.CFrame
    local f = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
    local r = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
    if f.Magnitude < 0.01 then return Vector3.zero end
    f, r = f.Unit, r.Unit
    local x = worldDir:Dot(r)
    local z = worldDir:Dot(f)
    return Vector3.new(x, 0, z)
end

local function moveTowards(pos, speedMult)
    local root = myRoot()
    if not root then return end
    local dir = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
    if dir.Magnitude < 0.5 then
        stopMoving()
        return
    end
    local input = worldToInput(dir.Unit)
    setMoveInput(input * (speedMult or 1))
end

