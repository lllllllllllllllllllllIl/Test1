local SHR = SH:AddRightGroupbox("Shot Meter")

local MeterKit = {}

-- The game keeps its meter list in Aero's settings config, and every style it
-- offers already exists as a BillboardGui named "<Type>Meter" on our own
-- HumanoidRootPart or Head. So the picker reads the real list and switches the
-- real object - no invented models, no cloning.
local METER_FALLBACK = { "Arrow","Bat","Diamond","Funnel","Funnel2","Hoop","Pill","Rocket","Roblox","Tube","Vertical" }

function MeterKit.types()
    local rs = game:GetService("ReplicatedStorage")
    local out = {}
    local ok, cfg = pcall(function()
        local aero = rs:FindFirstChild("Aero")
        local shared = aero and aero:FindFirstChild("Shared")
        local conf = shared and shared:FindFirstChild("Config")
        local settings = conf and conf:FindFirstChild("Settings")
        local meter = settings and settings:FindFirstChild("Meter")
        return meter and require(meter)
    end)
    if ok and type(cfg) == "table" then
        for _, row in ipairs(cfg) do
            if row.settingName == "Type" and type(row.options) == "table" then
                for _, name in ipairs(row.options) do
                    if name ~= "None" then out[#out + 1] = name end
                end
                break
            end
        end
    end
    if #out == 0 then
        for _, name in ipairs(METER_FALLBACK) do out[#out + 1] = name end
    end
    table.sort(out)
    return out
end

function MeterKit.names() return MeterKit.types() end

-- Live meter parts on our own character, keyed by style name.
function MeterKit.parts()
    local map = {}
    local chars = workspace:FindFirstChild("Characters")
    local char = chars and chars:FindFirstChild(me.Name)
    if not char then return map end
    for _, holder in ipairs({ char:FindFirstChild("HumanoidRootPart"), char:FindFirstChild("Head") }) do
        if holder then
            for _, c in ipairs(holder:GetChildren()) do
                local style = c.Name:match("^(.+)Meter$")
                if style and c:IsA("BillboardGui") then map[style] = c end
            end
        end
    end
    return map
end

function MeterKit.current()
    for style, gui in pairs(MeterKit.parts()) do
        if gui.Enabled then return style end
    end
    return S.meterPick ~= "" and S.meterPick or "-"
end

-- The server owns the active style. UpdateSetting is exactly what the game's own
-- settings menu fires when you pick a meter type, so this switches it properly
-- instead of layering a second meter on top.
function MeterKit.apply(name)
    if not name or name == "" or name == "None" then return false, "pick a meter first" end
    local have = MeterKit.parts()
    if not have[name] then return false, "no " .. tostring(name) .. "Meter on the character" end
    local remote = nil
    pcall(function()
        remote = game:GetService("ReplicatedStorage").Aero.AeroRemoteServices.PlayerService.UpdateSetting
    end)
    local sent = false
    if remote then
        sent = pcall(function() remote:FireServer({ "Meter" }, "Type", name) end)
    end
    for style, gui in pairs(have) do
        if style ~= name then pcall(function() gui.Enabled = false end) end
    end
    pcall(function() have[name].Enabled = true end)
    S.meterPick = name
    S.meterLastAt = os.clock()
    return true, name .. (sent and " set" or " set (client only)")
end

