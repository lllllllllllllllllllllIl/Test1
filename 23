local function pingSeconds()
    local ok, ping = pcall(function()
        return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    local ms = (ok and type(ping) == "number") and ping or 60
    return ms / 1000
end

local function releaseDelay()
    local d = S.autoTimeDelay - pingSeconds() * S.autoTimePingComp
    -- Moving shots need a slightly later release: the shooting animation starts
    -- a few frames after the footplant, so the green window arrives later.
    if S.autoMovingShot and (S.armVelocity or 0) >= S.movingShotVelThresh then
        d = d + S.movingShotDelayBonus
    end
    return math.clamp(d, S.autoTimeMin, S.autoTimeMax)
end

local function playGreenFx(name) end -- forward declaration

local function doRelease(tag)
    if not S.shotArmed then return end
    if os.clock() - S.armedAt < 0.05 then return end
    if os.clock() - S.lastRelease < 0.05 then return end
    S.lastRelease = os.clock()
    S.shotArmed = false
    send(InputS, "Shoot", { Shoot = false, Input = "E" })
    if tag == "green" and S.greenFxAuto then
        -- Goal FX override: one effect only. Whatever is picked in the Goal FX
        -- dropdown wins and the normal Green Effect never stacks on top.
        local fxName = S.greenFx
        if S.goalFxOverride and S.goalFx then fxName = S.goalFx end
        pcall(playGreenFx, fxName)
    end
    if S.autoTimeNotify then
        notify("Auto Time", string.format("%s  %.3fs  ping %dms", tostring(tag),
            releaseDelay(), math.floor(pingSeconds() * 1000)))
    end
end

local function armShot()
    if S.shotArmed then return end
    S.shotArmed = true
    S.shotToken += 1
    S.shotT0 = os.clock()
    S.armedAt = os.clock()
    S.meterSeen = false
    S.meterFillLast = nil
    S.shotBaseOff = nil      -- Release At Full records the resting offset on its first frame
    S.meterAxis = nil        -- Lock onto whichever meter axis moves
    S.fullLastFill, S.fullLastT, S.fullVel = nil, nil, nil
    S.fullPeak = nil
    S.lastOffSeen = nil
    S.axMin, S.axMax, S.axMinT, S.axMaxT, S.axRawVal = nil, nil, nil, nil, nil
    S.meterDirection = 0
    local token = S.shotToken
    -- Detect moving shot: capture velocity at arm time for timing adjustment
    if S.autoMovingShot then
        local pktB = myPkt()
        local rootB = pktRoot(pktB)
        if rootB then
            local mv = rootB.AssemblyLinearVelocity
            local flat = Vector3.new(mv.X, 0, mv.Z)
            S.armVelocity = flat.Magnitude  -- used in releaseDelay()
        else
            S.armVelocity = 0
        end
    else
        S.armVelocity = 0
    end
    if S.releaseAtFull then
        -- Safety net only: a meter that never moves must not leave the shot armed.
        task.delay(6, function()
            if token == S.shotToken and S.shotArmed and not S.meterAxis then
                print("[PB full] no meter movement, timeout")
                doRelease("timeout")
            end
        end)
    else
        task.delay(S.autoTimeMax + 0.35, function()
            if token == S.shotToken and S.shotArmed then doRelease("timeout") end
        end)
    end
end

local function meterFill()
    local C = PlayerCtrl and PlayerCtrl.Character
    if not C then
        local mv = getMovement()
        C = mv and mv.State
    end
    if not C then return nil end
    local off
    if type(C.GetAttribute) == "function" then
        off = C:GetAttribute("meterOffset")
    end
    if typeof(off) == "Vector2" then
        return math.clamp(off.Y + 1, 0, 1)
    end
    if type(off) == "number" then return math.clamp(off, 0, 1) end
    return nil
end

local function meterReleasePoint()
    if os.clock() - S.shotT0 < 0.06 then return false end
    local fill = meterFill()
    if not fill then return false end
    if S.meterFillLast then
        local d = fill - S.meterFillLast
        if math.abs(d) > 1e-5 then
            S.meterDirection = d > 0 and 1 or -1
            S.meterSeen = true
        end
    end
    S.meterFillLast = fill
    if not S.meterSeen then return false end
    local pct = math.clamp(S.meterGreen, 0, 100) / 100
    if pct <= 0 or pct >= 1 then return false end
    if S.meterDirection > 0 then
        if fill >= 1 - pct then doRelease("green") return true end
    else
        if fill <= pct then doRelease("green") return true end
    end
    return false
end

-- Live meter fill for Release At Full. The meter can animate on either axis,
-- so capture its resting offset and lock onto the axis that actually moves.
-- Grade feedback from the game (1 Very Early .. 5 Perfect .. 8 Very Late). After a
-- Y-meter Release At Full shot, nudge that meter's fill target toward Perfect.
S.targetFrac = S.targetFrac or {}
local AeroFolderR = game:GetService("ReplicatedStorage"):FindFirstChild("Aero")
local IFRemotes = AeroFolderR and AeroFolderR:FindFirstChild("AeroRemoteServices")
local IFEvent = IFRemotes and IFRemotes:FindFirstChild("InterfaceService")
IFEvent = IFEvent and IFEvent:FindFirstChild("ShowFeedback")
if IFEvent and IFEvent:IsA("RemoteEvent") then
    track(IFEvent.OnClientEvent:Connect(function(model, _contest, gradeIdx)
        if not S.lastRestKey or not S.lastYFrame then return end
        if os.clock() - S.lastYFrame > 4 then return end
        if typeof(model) ~= "Instance" or model.Name ~= me.Name then return end
        local g = tonumber(gradeIdx)
        if not g then return end
        local key = S.lastRestKey
        S.lastRestKey, S.lastYFrame = nil, nil
        local cur = S.targetFrac[key] or 0.95
        -- step scales with how far off the grade was
        local stepFor = { [1] = 0.04, [2] = 0.025, [3] = 0.012, [6] = -0.012, [7] = -0.025, [8] = -0.04 }
        local step = stepFor[g] or 0
        if step ~= 0 then
            -- early (+): release later, so aim higher; late (-): aim lower
            S.targetFrac[key] = math.clamp(cur + step, 0.3, 1.0)
        end
        print(string.format("[PB full] grade=%d rest=%s target=%.3f", g, key, S.targetFrac[key] or cur))
    end))
end

local function meterFillNow()
    local char = workspace.Characters:FindFirstChild(me.Name)
    local off = char and char:GetAttribute("meterOffset")
    if typeof(off) ~= "Vector2" then return nil end
    -- A big one-frame jump before any axis is locked is the meter resetting when
    -- armed, not a swing. Re-base on the new value so the jump can't lock an axis.
    if S.lastOffSeen and not S.meterAxis and (off - S.lastOffSeen).Magnitude > 0.3 then
        S.shotBaseOff = off
    end
    S.lastOffSeen = off
    if not S.shotBaseOff then S.shotBaseOff = off end
    local base = S.shotBaseOff
    if not S.meterAxis then
        local dX = math.abs(off.X - base.X)
        local dY = math.abs(off.Y - base.Y)
        if math.max(dX, dY) > 0.08 then
            S.meterAxis = (dX >= dY) and "X" or "Y"
            print(string.format("[PB full] axis=%s base=(%.3f,%.3f) off=(%.3f,%.3f)",
                S.meterAxis, base.X, base.Y, off.X, off.Y))
        end
    end
    if not S.meterAxis then return nil end
    S.axRawVal = (S.meterAxis == "X") and off.X or off.Y
    if S.meterAxis == "X" then return math.clamp(off.X, 0, 1) end
    -- Y meters swing down from rest and bounce back; fill is distance from rest.
    return math.clamp(base.Y - off.Y, 0, 1)
end

-- Smooth fill speed between frames and release when the target is reached,
-- or predict its arrival when the remaining time is within the ping lead.
local function fillReachedTarget(fill, target)
    local now = os.clock()
    if S.fullLastFill and S.fullLastT and now > S.fullLastT then
        local inst = (fill - S.fullLastFill) / (now - S.fullLastT)
        if inst > 0 then
            S.fullVel = S.fullVel and (S.fullVel * 0.6 + inst * 0.4) or inst
        end
    end
    S.fullLastFill, S.fullLastT = fill, now
    if fill >= target then return true end
    local vel = S.fullVel or 0
    if vel <= 0 then return false end
    local timeToTarget = (target - fill) / vel
    local lead = pingSeconds() * S.autoTimePingComp + 0.02
    return timeToTarget <= lead
end

