--========================================================--
--  REC FARM (simplified core loop)
--========================================================--
local function recFarmTick()
    if not S.recFarm then return end
    local pkt = myPkt()
    local root = pktRoot(pkt)
    if not pkt or not root then
        S.recState = "no character"
        return
    end
    local now = os.clock()
    local myPos = root.Position
    local held = pktHasBall(pkt)

    recMatchTick(pkt, now)

    -- possession helpers
    local mates, opps = {}, {}
    for _, p in ipairs(allPackets()) do
        if p ~= pkt then
            local r = pktRoot(p)
            local e = { pkt = p, pos = r and r.Position or myPos, root = r }
            if isOpponent(p) then opps[#opps + 1] = e else mates[#mates + 1] = e end
        end
    end

    local teamHasBall = held
    local oppHasBall = false
    for _, e in ipairs(mates) do if pktHasBall(e.pkt) then teamHasBall = true end end
    for _, e in ipairs(opps) do if pktHasBall(e.pkt) then oppHasBall = true end end

    local poss = held and "us" or (teamHasBall and "team" or (oppHasBall and "them" or "loose"))

    if S.recFarmSprint then
        if not S.sprintOn then
            S.sprintOn = true
            send(InputS, "Sprint", true)
        end
    end

    -- offense: we have ball
    if held then
        local _, dist = nearestOpponent(150, false)
        if shotAllowed() and (dist or 999) >= (S.shootOpenRange or 7)
            and now - (S.lastRelease or 0) > 1.0 and not S.shotArmed then
            S.recState = "shooting"
            stopMoving()
            shootNow()
            S.statShots = (S.statShots or 0) + 1
            return
        end
        -- try pass if heavily contested
        if dist and dist < 4 then
            if recTryPass("pressured", 1) then
                S.recState = "passing under pressure"
                return
            end
        end
        -- move toward open look / hoop
        local goal = goalPosition()
        if goal then
            S.recState = "attacking"
            moveTowards(Vector3.new(goal.X, myPos.Y, goal.Z), 0.85)
        end
        return
    end

    -- teammate has ball: space out
    if teamHasBall then
        local carrier = teammateBallCarrier()
        local croot = carrier and pktRoot(carrier)
        if croot then
            local away = myPos - croot.Position
            away = Vector3.new(away.X, 0, away.Z)
            if away.Magnitude < 8 then
                S.recState = "spacing"
                if away.Magnitude > 0.1 then
                    moveTowards(myPos + away.Unit * 12, 0.8)
                end
            else
                stopMoving()
                S.recState = "open"
            end
        end
        return
    end

    -- defense
    if oppHasBall then
        local carrier, cd = nearestOpponent(200, true)
        if carrier then
            local oroot = pktRoot(carrier)
            if oroot then
                S.recState = "guarding"
                guardMove(oroot, cd or 10)
                if S.autoSteal and cd and cd < S.guardRange and now - (S.recLastSteal or 0) > 0.45 then
                    S.recLastSteal = now
                    S.statSteals = (S.statSteals or 0) + 1
                    send(InputS, "Steal")
                end
                local act = pktAttr(carrier, "Action")
                if S.autoContest and cd and cd < 7 and
                    (act == "Shooting" or act == "Dunking" or act == "Gathering") and
                    now - (S.lastJump or 0) > 0.9 then
                    S.lastJump = now
                    send(InputS, "Jump")
                end
            end
        else
            stopMoving()
            S.recState = "defending (holding)"
        end
        return
    end

    -- loose ball
    local ball = looseBall(120)
    if ball and inCourt(ball.Position) then
        if S.recRebound then
            S.recState = "chasing loose ball"
            moveTowards(ball.Position, 1)
        else
            local goal = goalPosition()
            if goal then
                local dir = ball.Position - goal
                dir = Vector3.new(dir.X, 0, dir.Z)
                local box = goal
                if dir.Magnitude > 0.01 then box = goal + dir.Unit * 7 end
                S.recState = "boxing out"
                moveTowards(Vector3.new(box.X, myPos.Y, box.Z), 0.9)
            end
        end
        return
    end

    S.recState = "waiting"
    stopMoving()
end

--========================================================--
--  MAIN FRAME LOOP
--========================================================--
local function frameStep()
    if S.cleaned then return end

    local pkt = myPkt()
    local root = pktRoot(pkt)
    local held = pktHasBall(pkt)

    -- Auto Time (timer mode)
    if S.shotArmed and S.autoTime and not S.releaseAtFull then
        if os.clock() - S.shotT0 >= releaseDelay() then
            doRelease("timer")
        end
    end

    guardTick(pkt)

    if S.ballMag and root and not held then pcall(magnetTick, root) end

    local movementClaimed = false

    if S.recFarm then
        movementClaimed = true
        pcall(recFarmTick)
    end

    if not movementClaimed and (S.autoGuard or S.autoSteal) and root then
        local carrier, cd = nearestOpponent(S.guardRange + 20, true)
        if carrier and cd then
            local oroot = pktRoot(carrier)
            if oroot then
                if S.autoGuard then
                    guardMove(oroot, cd)
                    movementClaimed = true
                end
                if S.autoSteal and cd < S.guardRange and os.clock() - S.lastSteal > 0.45 then
                    S.lastSteal = os.clock()
                    S.statSteals = (S.statSteals or 0) + 1
                    send(InputS, "Steal")
                end
            end
        elseif S.autoGuard then
            S.guardApproaching = false
            if S.guardState then setGuard(false) end
            stopMoving()
        end
    end

    if S.autoContest and root then
        local shooter, sd = nearestOpponent(9, true)
        local act = shooter and pktAttr(shooter, "Action") or ""
        S.contestAction = tostring(act)
        if shooter and sd and (act == "Shooting" or act == "Dunking" or act == "Gathering" or act == "CatchingPass") then
            if not movementClaimed then moveTowards(pktRoot(shooter).Position, 1) end
            if os.clock() - S.lastJump > 0.8 then
                S.lastJump = os.clock()
                send(InputS, "Jump")
            end
        end
    end

    if not movementClaimed and S.autoShoot and held and not S.shotArmed then
        local _, dist = nearestOpponent(150, false)
        if shotAllowed() and (dist or 999) >= S.shootOpenRange
            and os.clock() - S.lastRelease > 1.0 then
            stopMoving()
            shootNow()
        end
    end

    if S.offenseGuard and root and not held then
        local carrier = nearestOpponent(100, true)
        if carrier then
            local oroot2 = pktRoot(carrier)
            if oroot2 and os.clock() - (S.lastOffGuard or 0) > 0.08 then
                S.lastOffGuard = os.clock()
                moveTowards(oroot2.Position, 1)
                movementClaimed = true
            end
        end
    end

    if S.smartFarm and not movementClaimed then
        pcall(smartFarmTick)
        movementClaimed = true
    end

    if S.autoClutch and ClutchR then
        pcall(function()
            if pktAttr(pkt, "Action") ~= "Dunking" then return end
            local nowAC = os.clock()
            if nowAC - (S.lastClutchAt or 0) < 0.5 then return end
            S.lastClutchAt = nowAC
            ClutchR:FireServer(true)
        end)
    end

    if S.autoBlowBy and held and not movementClaimed then
        local now_bb = os.clock()
        if now_bb - (S.blowByLast or 0) > 1.2 then
            pcall(function()
                local rootBB = myRoot()
                if not rootBB then return end
                local facingDir = rootBB.CFrame.LookVector
                for _, op in ipairs(allPackets()) do
                    if isOpponent(op) then
                        local or2 = pktRoot(op)
                        if or2 then
                            local toOpp = (or2.Position - rootBB.Position)
                            local dist = toOpp.Magnitude
                            if dist < 4 and facingDir:Dot(toOpp.Unit) > 0.5 then
                                S.blowByLast = now_bb
                                send(InputS, "Sprint", { Sprinting = true })
                                send(InputS, "MoveDirection", { X = facingDir.X, Y = 0, Z = facingDir.Z })
                                playDribble("Crossover")
                                movementClaimed = true
                                break
                            end
                        end
                    end
                end
            end)
        end
    end

    if S.ankleBreaker and held then
        local now_ab = os.clock()
        if now_ab - (S.ankleLastFire or 0) > 0.8 then
            pcall(function()
                local rootAB = myRoot()
                if not rootAB then return end
                for _, op in ipairs(allPackets()) do
                    if isOpponent(op) then
                        local rop = pktRoot(op)
                        if rop then
                            local dist = (rop.Position - rootAB.Position).Magnitude
                            local act = tostring(pktAttr(op, "Action") or ""):lower()
                            local reaching = act:find("steal") or act:find("reach") or act:find("defend")
                            if dist < 3.5 or (dist < 5.5 and reaching) then
                                S.ankleLastFire = now_ab
                                playDribble(S.anklebreakerMove)
                                break
                            end
                        end
                    end
                end
            end)
        end
    end

    if S.infiniteStamina then
        pcall(function()
            local pktIS = myPkt()
            if pktIS then
                if not S.stamMax then
                    local mx = pktIS.model and pktIS.model:GetAttribute("MaxStamina")
                    S.stamMax = type(mx) == "number" and mx or 100
                end
                setAttr(pktIS, "Stamina", S.stamMax)
            end
        end)
    end

    sprintTick(pkt)

    -- CFrame speed
    if S.cfSpeed and root then
        local hum = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
        if hum and hum.MoveDirection.Magnitude > 0 then
            root.CFrame = root.CFrame + hum.MoveDirection * ((S.cfSpeedValue or 40) / 60)
        end
    end

    -- Speed with ball
    if S.speedWithBall and held and root then
        local hum = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
        if hum then pcall(function() hum.WalkSpeed = S.swbSpeed or 34 end) end
    end

    -- Hip height
    if S.hipHeight and root then
        pcall(function()
            local hum = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
            if hum then
                if not S.hipBaseY then S.hipBaseY = hum.HipHeight end
                hum.HipHeight = S.hipValue or 2
            end
        end)
    end

    if S.spoofCoins or S.spoofRank or S.spoofOverall or S.spoofName then
        applySpoofs()
    end
end

