local JoinPlaceR  = remote(InterSvc, "JoinPlace")

local function send(svc, name, ...)
    local args = table.pack(...)
    local wrapper = svc and svc[name]
    if type(wrapper) == "table" and type(wrapper.Fire) == "function" then
        local ok = pcall(function() wrapper:Fire(table.unpack(args, 1, args.n)) end)
        if ok then return true end
    end
    local folder = nil
    if svc == InputS then folder = InputSvc
    elseif svc == InvS then folder = Svc and Svc:FindFirstChild("InventoryService") end
    local r = remote(folder, name)
    if not r then return false end
    return (pcall(function() r:FireServer(table.unpack(args, 1, args.n)) end))
end

local function rawRemote(serviceName, remoteName)
    local svc = Svc and Svc:FindFirstChild(serviceName)
    return svc and svc:FindFirstChild(remoteName) or nil
end

local function rawFire(serviceName, remoteName, ...)
    local r = rawRemote(serviceName, remoteName)
    if not r then return false end
    local args = table.pack(...)
    if r:IsA("RemoteEvent") then
        return (pcall(function() r:FireServer(table.unpack(args, 1, args.n)) end))
    elseif r:IsA("RemoteFunction") then
        local ok = pcall(function() return r:InvokeServer(table.unpack(args, 1, args.n)) end)
        return ok
    end
    return false
end

