local function pingSeconds()
    local ok, v = pcall(function() return me:GetNetworkPing() end)
    if ok and type(v) == "number" then return v end
    return 0.05
end

local function releaseDelay()
    local d = S.autoTimeDelay or 0.3
    local ping = pingSeconds() * (S.autoTimePingComp or 0.55)
    d = d - ping
    if S.autoMovingShot then
        local root = myRoot()
        if root then
            local vel = root.AssemblyLinearVelocity
            local spd = Vector3.new(vel.X, 0, vel.Z).Magnitude
            if spd > 4 then d = d + (S.movingShotDelayBonus or 0.08) end
        end
    end
    return math.clamp(d, S.autoTimeMin or 0.12, S.autoTimeMax or 1.2)
end

local function doRelease(reason)
    if not S.shotArmed then return end
    S.shotArmed = false
    S.lastRelease = os.clock()
    pcall(function()
        if ShootR then
            ShootR:FireServer({ Shoot = false })
        else
            send(InputS, "Shoot", { Shoot = false })
        end
    end)
    if S.autoTimeNotify then
        notify("Auto Time", "released (" .. tostring(reason) .. ")")
    end
    if S.greenFxAuto and S.greenFx then
        task.defer(function()
            pcall(function()
                if gg.playGreenFx then gg.playGreenFx(S.greenFx) end
            end)
        end)
    end
end

local function armShot()
    S.shotArmed = true
    S.shotToken = (S.shotToken or 0) + 1
    S.shotT0 = os.clock()
end

local function shootNow()
    if S.shotArmed then return end
    pcall(function()
        if ShootR then
            ShootR:FireServer({ Shoot = true })
        else
            send(InputS, "Shoot", { Shoot = true })
        end
    end)
    armShot()
end

local function shotAllowed()
    local d = distToMyGoal()
    return d <= (S.recShootMaxRange or 55)
end

