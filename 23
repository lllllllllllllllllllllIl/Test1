    S.cleaned = true
    pcall(function() RunService:UnbindFromRenderStep("VH_Practical") end)
    for _, c in ipairs(S.conns) do pcall(function() c:Disconnect() end) end
    stopMoving()
    setGuard(false)
    pcall(function() if keyrelease then keyrelease(VK_G) end end)
    send(InputS, "Sprint", false)
    send(InputS, "HoldG", { HoldingG = false })
    if Controls and origGetMoveVector then
        pcall(function() rawset(Controls, "GetMoveVector", origGetMoveVector) end)
    end
    Library:Unload()
end)

MenuGroup:AddLabel("Vision Hub - Practical")
MenuGroup:AddLabel("Ported from Angel Hub build")

ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)
SaveManager:IgnoreThemeSettings()
SaveManager:SetIgnoreIndexes({ "MenuKeybind" })
ThemeManager:SetFolder("VisionHub")
SaveManager:SetFolder("VisionHub/configs")
SaveManager:BuildConfigSection(Tabs["UI Settings"])
ThemeManager:ApplyToTab(Tabs["UI Settings"])

-- expose for debugging
gg.VH_Practical = S
gg.playGreenFx = playGreenFx

notify("Vision Hub", "Practical loaded")
