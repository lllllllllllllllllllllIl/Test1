local function sortedKeys(tbl)
    local out = {}
    if type(tbl) == "table" then
        for k in pairs(tbl) do out[#out + 1] = tostring(k) end
        table.sort(out)
    end
    return out
end

local function accCatalog()
    local out = {}
    local accRoot = RS:FindFirstChild("Accessories")
    local cfg = AccessoriesCfg

    for _, cat in ipairs(MODEL_CATS) do
        local list = {}
        local folder = accRoot and accRoot:FindFirstChild(cat)
        if type(cfg) == "table" and type(cfg[cat]) == "table" and folder then
            for name in pairs(cfg[cat]) do
                if folder:FindFirstChild(tostring(name), true) then
                    list[#list + 1] = tostring(name)
                end
            end
        end
        table.sort(list)
        out[cat] = list
    end

    out.Shoes = sortedKeys(type(cfg) == "table" and cfg.Shoes or nil)

    local masc = {}
    local mf = accRoot and accRoot:FindFirstChild("Mascots")
    if mf then
        for _, c in ipairs(mf:GetChildren()) do masc[#masc + 1] = c.Name end
    end
    table.sort(masc)
    out.Mascot = masc

    for _, cat in ipairs(FLAT_CATS) do
        out[cat] = sortedKeys(type(cfg) == "table" and cfg[cat] or nil)
    end
    for _, cat in ipairs(LIST_CATS) do
        out[cat] = sortedKeys(type(cfg) == "table" and cfg[cat] or nil)
    end
    out.SkinTone = sortedKeys(type(cfg) == "table" and cfg.SkinTone or nil)
    return out
end

local function parseColor(s)
    if type(s) ~= "string" then return { 255, 255, 255 } end
    local r, g, b = s:match("(%d+)%s*,%s*(%d+)%s*,%s*(%d+)")
    if r then
        return {
            math.clamp(tonumber(r) or 255, 0, 255),
            math.clamp(tonumber(g) or 255, 0, 255),
            math.clamp(tonumber(b) or 255, 0, 255),
        }
    end
    local hex = s:match("^#?(%x%x%x%x%x%x)$")
    if hex then
        return {
            tonumber(hex:sub(1, 2), 16) or 255,
            tonumber(hex:sub(3, 4), 16) or 255,
            tonumber(hex:sub(5, 6), 16) or 255,
        }
    end
    return { 255, 255, 255 }
end

local function wearCosmetic(cat, name, color)
    local pkt = myPkt()
    if not pkt or type(pkt.UpdateAppearance) ~= "function" then return false, "no character packet" end
    if not name or name == "" or name == "None" then return false, "pick an item" end
    local ok, err = pcall(function()
        local payload = {}
        if cat == "Mascot" then
            payload.Mascot = { name }
        elseif cat == "SkinTone" then
            payload.SkinTone = name
        else
            payload[cat] = name
        end
        if color and type(color) == "table" then
            payload.Color = color
        end
        pkt:UpdateAppearance(payload)
    end)
    if not ok then return false, tostring(err) end
    return true
end

local function clearCosmetic(cat)
    local pkt = myPkt()
    if not pkt or type(pkt.UpdateAppearance) ~= "function" then return false, "no character packet" end
    local ok, err = pcall(function()
        if cat == "Mascot" then
            pkt:UpdateAppearance({ Mascot = { "None" } })
        elseif cat == "Jersey" or cat == "Shirt" or cat == "Pants" then
            pkt:UpdateAppearance({ [cat] = "" })
        else
            pkt:UpdateAppearance({ [cat] = {} })
        end
    end)
    if not ok then return false, tostring(err) end
    return true
end

-- Spoofers
local function applySpoofs()
    if not PlayerCtrl then return end
    local pd = PlayerCtrl.ProfileData
    if type(pd) ~= "table" then return end
    if S.spoofCoins then pcall(function() pd.Coins = S.coinsValue end) end
    if S.spoofRank then
        pcall(function() pd.Reputation = S.rankValue end)
        pcall(function() pd.RepEXP = 999999 end)
    end
    if S.spoofOverall then
        local sd = PlayerCtrl.SlotData
        if type(sd) == "table" then pcall(function() sd.StartingOverall = S.overallValue end) end
        local slot = pd.Slots and pd.Slots[tostring(pd.Slot or "1")]
        if type(slot) == "table" then pcall(function() slot.StartingOverall = S.overallValue end) end
    end
    if S.spoofName then
        pcall(function() PlayerCtrl.Name = S.nameValue end)
        pcall(function() me:SetAttribute("BuildNickname", S.nameValue) end)
        pcall(function() rawset(me, "Name", S.nameValue) end)
        pcall(function() rawset(me, "DisplayName", S.nameValue) end)
        pcall(function()
            local C = PlayerCtrl and PlayerCtrl.Character
            local hum = C and C:FindFirstChildOfClass("Humanoid")
            if hum then hum.DisplayName = S.nameValue end
        end)
    end
end

