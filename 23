    -- Dunk override
    if S.animDunk ~= "None" and S.animDunk ~= "" then
        pcall(function()
            if pkt.model then pkt.model:SetAttribute("BaseAnimation", S.animDunk) end
            setAttr(pkt, "BaseAnimation", S.animDunk)
        end)
    end
end

-- Always routed through Auto Time: fire the press, arm, let the timer release.
local function shootNow()
