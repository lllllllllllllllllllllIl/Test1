            local d = (plr.Character.HumanoidRootPart.Position - root.Position).Magnitude
            if d < range then open = false break end
        end
    end
    if open then
        send(InputS, "Shoot", { Shoot = true, Input = "E" })
        lastAutoShoot = now
    end
end))

