-- Webhook URL survives a re-inject the same way RH2's did: a flat file next to
-- the executor workspace, reloaded before the UI is built.
WEBHOOK_FILE = "PracticalHub_webhook.txt"

function saveWebhookFile()
    if type(writefile) ~= "function" then return end
    pcall(writefile, WEBHOOK_FILE,
        (S.webhookOn and "1" or "0") .. "\n" .. tostring(S.webhookURL or ""))
end

function loadWebhookFile()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return end
    local ok, exists = pcall(isfile, WEBHOOK_FILE)
    if not ok or not exists then return end
    local ok2, raw = pcall(readfile, WEBHOOK_FILE)
    if not ok2 or type(raw) ~= "string" then return end
    local on, url = raw:match("^(%d)\r?\n?(.*)$")
    if on then S.webhookOn = (on == "1") end
    if url and url ~= "" then S.webhookURL = (url:gsub("%s", "")) end
end

