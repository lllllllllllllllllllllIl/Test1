local AeroFolder = RS:FindFirstChild("Aero")
local Svc = AeroFolder and AeroFolder:FindFirstChild("AeroRemoteServices")
if not Svc then
    Library:Notify({ Title = "Error", Description = "Aero framework not found", Time = 4 })
    return
end

local PS = me:FindFirstChild("PlayerScripts")
local AeroClient = PS and PS:FindFirstChild("Aero")
local Ctrl = AeroClient and AeroClient:FindFirstChild("Controllers")

local function req(parent, name)
    local m = parent and parent:FindFirstChild(name)
    if not m then return nil end
    local ok, res = pcall(require, m)
    return ok and res or nil
end

local PlayerCtrl = req(Ctrl, "Player")
local Services = PlayerCtrl and PlayerCtrl.Services
local InputS = Services and Services.InputService

local function remote(parent, name)
    return parent and parent:FindFirstChild(name) or nil
end

local InputSvc = Svc:FindFirstChild("InputService")

local function send(svc, name, ...)
    local args = table.pack(...)
    local wrapper = svc and svc[name]
    if type(wrapper) == "table" and type(wrapper.Fire) == "function" then
        local ok = pcall(function() wrapper:Fire(table.unpack(args, 1, args.n)) end)
        if ok then return true end
    end
    local r = remote(InputSvc, name)
    if r then
        return pcall(function() r:FireServer(table.unpack(args, 1, args.n)) end)
    end
    return false
end

