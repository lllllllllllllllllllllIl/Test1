end

-- Movement override
local Controls, origGetMoveVector = nil, nil
local moveOverride = nil

do
    local ok, pm = pcall(function() return require(PS:WaitForChild("PlayerModule", 5)) end)
    if ok and pm then
        local ok2, c = pcall(function() return pm:GetControls() end)
        if ok2 and c then
            local orig = rawget(c, "GetMoveVector")
            if type(orig) ~= "function" then orig = c.GetMoveVector end
            if type(orig) == "function" then
                local patched = function(self, ...)
                    if moveOverride then return moveOverride end
                    return orig(self, ...)
                end
                pcall(function() rawset(c, "GetMoveVector", patched) end)
                pcall(function() c.GetMoveVector = patched end)
                local mt = getmetatable(c)
                if type(mt) == "table" and type(mt.__index) == "table" then
                    pcall(function() mt.__index.GetMoveVector = patched end)
                end
                if c.GetMoveVector == patched then
                    Controls, origGetMoveVector = c, orig
                end
            end
        end
    end
end

local function setMoveInput(v) moveOverride = v end
local function stopMoving() setMoveInput(nil) end

local function worldToInput(dir)
    local cam = WS.CurrentCamera
    if not cam then return Vector3.new(0, 0, 0) end
    local flat = Vector3.new(dir.X, 0, dir.Z)
    if flat.Magnitude < 1e-4 then return Vector3.new(0, 0, 0) end
    flat = flat.Unit
    local cf = cam.CFrame
    local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
    local right = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
    if look.Magnitude < 1e-3 and right.Magnitude < 1e-3 then return Vector3.new(0, 0, 0) end
    local x = right.Magnitude > 1e-3 and flat:Dot(right.Unit) or 0
    local z = look.Magnitude > 1e-3 and -flat:Dot(look.Unit) or 0
    local m = math.sqrt(x * x + z * z)
    if m > 1 then x, z = x / m, z / m end
    return Vector3.new(x, 0, z)
end

local function moveTowards(pos, weight)
    local root = myRoot()
    if not root then setMoveInput(nil) return end
    local d = pos - root.Position
    d = Vector3.new(d.X, 0, d.Z)
    if d.Magnitude < 0.5 then setMoveInput(nil) return end
    setMoveInput(worldToInput(d) * (weight or 1))
end

