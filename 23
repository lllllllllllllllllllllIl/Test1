local DribbleGlide = {
    Enabled = true,
    GlideSpeed = 25,
}
getgenv().DribbleGlide = DribbleGlide

local function Flat(v) return Vector3.new(v.X, 0, v.Z) end

local function GetProxy()
    local p = WS:FindFirstChild("ProxyCharacter")
    if p and p:FindFirstChild("MovementVelocity") then
        return p
    end
end

RunService.Stepped:Connect(function(_, dt)
    if not DribbleGlide.Enabled then return end
    local proxy = GetProxy()
    if not proxy then return end
    local char = WS:FindFirstChild("Characters") and WS.Characters:FindFirstChild(me.Name)
    if not char or char:GetAttribute("Action") ~= "Dribbling" then return end
    local moving = Flat(proxy.AssemblyLinearVelocity)
    if moving.Magnitude > 1 then
        proxy.CFrame += moving.Unit * (DribbleGlide.GlideSpeed / 100 * 16) * dt
    end
end)

