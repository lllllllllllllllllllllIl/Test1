local InvS     = Services and Services.InventoryService

local function remote(parent, name)
    return parent and parent:FindFirstChild(name) or nil
end

local InputSvc    = Svc and Svc:FindFirstChild("InputService")
local MeterSvc    = Svc and Svc:FindFirstChild("MeterService")
local InterSvc    = Svc and Svc:FindFirstChild("InterfaceService")
