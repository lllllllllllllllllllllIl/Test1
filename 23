local ACC_CATS = { "Hats", "Faces", "Shirts", "Pants", "Shoes", "Accessories", "Emotes" }

local S = {
    accCat = "Hats",
    accItem = "None",
    accColor = "255,255,255",
}

local function accCatalog()
    local catalog = {}
    for _, cat in ipairs(ACC_CATS) do
        catalog[cat] = {}
    end

    local AeroShared = RS:FindFirstChild("Aero") and RS.Aero:FindFirstChild("Shared")
    local AccessoriesCfg = AeroShared and AeroShared:FindFirstChild("Config") and AeroShared.Config:FindFirstChild("Accessories")

    if AccessoriesCfg then
        local ok, cfg = pcall(require, AccessoriesCfg)
        if ok and type(cfg) == "table" then
            for cat, items in pairs(cfg) do
                if type(items) == "table" then
                    catalog[cat] = catalog[cat] or {}
                    for name, _ in pairs(items) do
                        table.insert(catalog[cat], tostring(name))
                    end
                    table.sort(catalog[cat])
                end
            end
        end
    end

    for cat, list in pairs(catalog) do
        if #list == 0 then
            list[1] = "None"
        end
    end
    return catalog
end

local function parseColor(str)
    if not str or str == "" then return Color3.new(1, 1, 1) end
    str = tostring(str):gsub("%s+", "")

    local hex = str:match("^#?(%x%x%x%x%x%x)$")
    if hex then
        local r = tonumber(hex:sub(1, 2), 16) / 255
        local g = tonumber(hex:sub(3, 4), 16) / 255
        local b = tonumber(hex:sub(5, 6), 16) / 255
        return Color3.new(r, g, b)
    end

    local r, g, b = str:match("^(%d+),(%d+),(%d+)$")
    if r and g and b then
        return Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b))
    end

    return Color3.new(1, 1, 1)
end

local function clearCosmetic(category)
    local char = getChar()
    if not char then return false, "character not found" end

    local ok = pcall(function()
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Accessory") or child:IsA("Shirt") or child:IsA("Pants") then
                if tostring(child.Name):lower():find(category:lower()) or child:GetAttribute("Category") == category then
                    child:Destroy()
                end
            end
        end
    end)
    return ok
end

local function wearCosmetic(category, itemName, color)
    if not category or not itemName or itemName == "None" then
        return false, "invalid category or item"
    end

    local char = getChar()
    if not char then return false, "character not found" end

    clearCosmetic(category)

    local ok, err = pcall(function()
        -- Try game systems first
        local Aero = RS:FindFirstChild("Aero")
        local InvS = Aero and Aero:FindFirstChild("AeroRemoteServices") and Aero.AeroRemoteServices:FindFirstChild("InventoryService")

        if InvS and InvS.Wear then
            InvS:Wear(category, itemName, color)
            return
        end

        -- Fallback: clone from Assets
        local assets = RS:FindFirstChild("Assets")
        local folder = assets and assets:FindFirstChild(category)
        local model = folder and folder:FindFirstChild(itemName)

        if model then
            local clone = model:Clone()
            if color then
                for _, part in ipairs(clone:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Color = color
                    end
                end
            end
            clone.Parent = char
        else
            error("item not found in assets")
        end
    end)

    return ok, err
end

