-- The game only fires RunGreenEffect to clients the server believes own the
-- effect. Equipping client-side never reaches the server, so play it here.
local function greenFxModule()
    if S.gfxMod then return S.gfxMod end
    local vis = Ctrl and Ctrl:FindFirstChild("Visuals")
    local comb = vis and vis:FindFirstChild("Combined")
    local mod = req(comb, "GreenEffects")
    if not mod and Ctrl then
        local v2 = Ctrl:FindFirstChild("Visuals", true)
        local c2 = v2 and v2:FindFirstChild("Combined", true)
        mod = req(c2, "GreenEffects")
    end
    if mod then S.gfxMod = mod end
    return mod
end

playGreenFx = function(name)
    if type(name) ~= "string" or name == "" then return false, "no effect" end
    local mod = greenFxModule()
    if not mod or type(mod.RunEffect) ~= "function" then return false, "no module" end
    local pkt = myPkt()
    if not pkt or not pkt.model then return false, "no character" end
    local ball = looseBall(18) or pktRoot(pkt)
    local goal = myGoal() or pktRoot(pkt)
    if not ball or not goal then return false, "no anchor" end
    local ok, err = pcall(function()
        mod:RunEffect(pkt.model, ball, goal, WS:GetServerTimeNow(), name)
    end)
    if not ok then return false, tostring(err) end
    -- also fire server remotes so everyone sees the effect + celebration
    pcall(function()
        if RunGreenR then RunGreenR:FireServer() end
        if GreenCelebR then GreenCelebR:FireServer() end
    end)
    return true
end

local function applyGreenFx(id)
    if type(id) ~= "string" then return false, "no id" end
    S.greenFx = id
    local ok = false
    if InvS and type(InvS.EquipEffect) == "function" then
        local okc, res = pcall(function() return InvS:EquipEffect(id) end)
        ok = okc and res and true or false
    end
    local pd = PlayerCtrl and PlayerCtrl.ProfileData
    if type(pd) == "table" then
        pcall(function() pd.GreenEffect = id end)
        pcall(function()
            if type(pd.SavedSettings) ~= "table" then pd.SavedSettings = {} end
            if type(pd.SavedSettings.Graphics) ~= "table" then pd.SavedSettings.Graphics = {} end
            pd.SavedSettings.Graphics.GreenEffects = true
        end)
    end
    S.greenFxEquipped = ok
    return ok
end

local function playCelebration(name)
    if type(name) ~= "string" then return false end
    return send(InputS, "GreenAnimation", name)
end

