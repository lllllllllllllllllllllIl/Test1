local MODEL_CATS = {"Hats", "Hair", "FacialHair", "Glasses", "Chain", "Backpack"}
local FLAT_CATS  = {"Jersey", "Shirt", "Pants"}
local LIST_CATS  = {"Compression", "LegCompression"}

local ACC_CATS = {
    "Hats", "Hair", "FacialHair", "Glasses", "Chain", "Backpack",
    "Shoes", "Mascot", "Jersey", "Shirt", "Pants",
    "Compression", "LegCompression", "SkinTone"
}

local function sortedKeys(tbl)
    local out = {}
    if type(tbl) == "table" then
        for k in pairs(tbl) do
            table.insert(out, tostring(k))
        end
        table.sort(out)
    end
    return out
end

local AccessoriesCfg = nil

local function getAccessoriesCfg()
    local ok, result = pcall(function()
        local Aero = RS:FindFirstChild("Aero")
        if not Aero then return nil end
        local Shared = Aero:FindFirstChild("Shared")
        if not Shared then return nil end
        local Config = Shared:FindFirstChild("Config")
        if not Config then return nil end
        local Accessories = Config:FindFirstChild("Accessories")
        if Accessories and Accessories:IsA("ModuleScript") then
            return require(Accessories)
        end
        return nil
    end)
    return ok and result or nil
end

AccessoriesCfg = getAccessoriesCfg()

local function myPkt()
    local char = getChar()
    if not char then return nil end

    if char:FindFirstChild("Packet") then
        return char.Packet
    end
    if char:FindFirstChild("Appearance") then
        return char.Appearance
    end
    return nil
end

local function accCatalog()
    local out = {}
    local accRoot = RS:FindFirstChild("Accessories")
    local cfg = AccessoriesCfg

    for _, cat in ipairs(MODEL_CATS) do
        local list = {}
        local folder = accRoot and accRoot:FindFirstChild(cat)
        if type(cfg) == "table" and type(cfg[cat]) == "table" and folder then
            for name in pairs(cfg[cat]) do
                if folder:FindFirstChild(tostring(name), true) then
                    table.insert(list, tostring(name))
                end
            end
        end
        table.sort(list)
        out[cat] = list
    end

    out.Shoes = sortedKeys(type(cfg) == "table" and cfg.Shoes)

    local masc = {}
    local mf = accRoot and accRoot:FindFirstChild("Mascots")
    if mf then
        for _, c in ipairs(mf:GetChildren()) do
            table.insert(masc, c.Name)
        end
    end
    table.sort(masc)
    out.Mascot = masc

    for _, cat in ipairs(FLAT_CATS) do
        out[cat] = sortedKeys(type(cfg) == "table" and cfg[cat])
    end
    for _, cat in ipairs(LIST_CATS) do
        out[cat] = sortedKeys(type(cfg) == "table" and cfg[cat])
    end

    out.SkinTone = sortedKeys(type(cfg) == "table" and cfg.SkinTone)
    return out
end

local function parseColor(s)
    if type(s) \~= "string" then return {255, 255, 255} end
    local r, g, b = s:match("(%d+)%s*,%s*(%d+)%s*,%s*(%d+)")
    if r then
        return {
            math.clamp(tonumber(r) or 255, 0, 255),
            math.clamp(tonumber(g) or 255, 0, 255),
            math.clamp(tonumber(b) or 255, 0, 255),
        }
    end
    local hex = s:match("^#?(%x%x%x%x%x%x)$")
    if hex then
        return {
            tonumber(hex:sub(1, 2), 16),
            tonumber(hex:sub(3, 4), 16),
            tonumber(hex:sub(5, 6), 16),
        }
    end
    return {255, 255, 255}
end

local function skinColorFromName(name)
    local cfg = AccessoriesCfg
    if type(cfg) == "table" and cfg.SkinTone and cfg.SkinTone[name] then
        local entry = cfg.SkinTone[name]
        if typeof(entry) == "Color3" then
            return {
                math.round(entry.R * 255),
                math.round(entry.G * 255),
                math.round(entry.B * 255),
            }
        end
    end
    return {255, 255, 255}
end

local function wearCosmetic(cat, name, color)
    if not cat or not name or name == "" or name == "None" then
        return false, "nothing selected"
    end

    local pkt = myPkt()
    if not pkt or type(pkt.UpdateAppearance) \~= "function" then
        return false, "appearance system not found"
    end

    color = color or {255, 255, 255}

    local ok, err = pcall(function()
        if cat == "Mascot" then
            pkt:UpdateAppearance({Mascot = {name}})
        elseif cat == "Shoes" then
            pkt:UpdateAppearance({
                Shoes = {
                    LeftShoe  = {name, color},
                    RightShoe = {name, color},
                }
            })
        elseif cat == "SkinTone" then
            pkt:UpdateAppearance({SkinTone = skinColorFromName(name)})
        elseif cat == "Jersey" or cat == "Shirt" or cat == "Pants" then
            pkt:UpdateAppearance({[cat] = name})
        else
            pkt:UpdateAppearance({[cat] = {{name, color}}})
        end
    end)

    return ok, err
end

local function clearCosmetic(cat)
    local pkt = myPkt()
    if not pkt or type(pkt.UpdateAppearance) \~= "function" then
        return false, "appearance system not found"
    end
    if cat == "Shoes" then return false, "can't clear shoes" end
    if cat == "SkinTone" then return false, "pick a different tone" end

    local ok, err = pcall(function()
        if cat == "Mascot" then
            pkt:UpdateAppearance({Mascot = {"None"}})
        elseif cat == "Jersey" or cat == "Shirt" or cat == "Pants" then
            pkt:UpdateAppearance({[cat] = ""})
        else
            pkt:UpdateAppearance({[cat] = {}})
        end
    end)

    return ok, err
end

