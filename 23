-- Runs on RenderStepped AFTER the game's own character update, because the
-- Aero Characters controller connected its listener before this script loaded.
-- ============================================================================

local SHOOT_ACTIONS = {
    Shooting = true, Dunking = true, Gathering = true, Layup = true,
    FreeThrow = true, CatchingPass = true, Stealing = true,
}

local function isLocked(pkt)
    if S.shotArmed then return true end
    if not pkt then return false end
    if pktAttr(pkt, "CanMove") == false then return true end
    local a = pktAttr(pkt, "Action")
    if type(a) == "string" and SHOOT_ACTIONS[a] then return true end
    return false
end

-- Lazy PlayerCtrl resolution: at script load the Aero controller may not be
-- initialized yet. Re-fetch each time until we have a valid Character.
local _cachedMv = nil
local function getMovement()
    if _cachedMv then return _cachedMv end
    local PC = PlayerCtrl
    if not PC then
        -- re-require if needed
        local PS2 = me:FindFirstChild("PlayerScripts")
        local AC2 = PS2 and PS2:FindFirstChild("Aero")
        local C2  = AC2 and AC2:FindFirstChild("Controllers")
        local m2  = C2 and C2:FindFirstChild("Player")
        if m2 then
            local ok2, pc2 = pcall(require, m2)
            if ok2 then PC = pc2 end
        end
    end
    local char = PC and PC.Character
    local mv = char and char.Movement
    if mv and mv.MovementVelocity and mv.Root then
        _cachedMv = mv
    end
    return mv
end

local function applyOverrides(dt)
    if S.cleaned then return end
    if not (S.cfSpeed or S.hipHeight or S.speedWithBall or S.walkBoost) then return end

    local mv = getMovement()
    if not mv or not mv.Root then return end

    local pkt = myPkt()
    if pkt and pkt.model ~= S.hipModel then
        S.hipModel = pkt.model
        S.hipBaseY = nil
    end
    local held = pktHasBall(pkt)
    local locked = isLocked(pkt)
    local body = mv.MovementVelocity
    local moved = false

    -- SpeedWithBall: velocity boost while truly holding the ball.
    local wantSpeedBoost = S.speedWithBall and held
    if body and wantSpeedBoost and not locked then
        local v = body.Velocity
        local flat = Vector3.new(v.X, 0, v.Z)
        local speed = flat.Magnitude
        if speed > 0.5 then
            local want = S.swbSpeed / speed
            if want > 1.001 then
                body.MaxForce = Vector3.new(1e6, 0, 1e6)
                body.Velocity = Vector3.new(v.X * want, v.Y, v.Z * want)
            end
        end
    end

    -- Walk Speed Boost: same proxy push, always on while moving. Adds a flat
    -- slice of the current speed on top, so it scales with sprint and stamina
    -- instead of fighting them, and it is capped so a fast build cannot fling.
    if S.walkBoost and not locked and not S.shotArmed then
        local vel = body and body.Velocity or mv.Root.AssemblyLinearVelocity
        local flat = Vector3.new(vel.X, 0, vel.Z)
        local sp = flat.Magnitude
        if sp > 1 then
            local mult = math.max(1, S.walkBoostMult or 1.6)
            local extra = math.min(sp * (mult - 1), S.walkBoostCap or 45)
            if extra > 0.01 then
                mv.Root.CFrame = mv.Root.CFrame + flat.Unit * extra * dt
                S.walkBoostPushes = (S.walkBoostPushes or 0) + 1
                S.walkBoostLastExtra = extra
                moved = true
            end
        end
    end

    -- CFrame Speed: never while the game has the character locked.
    if S.cfSpeed and not locked then
        local dir = mv.MoveDirection
        if dir.Magnitude > 0.05 then
            mv.Root.CFrame = mv.Root.CFrame + dir.Unit * S.cfSpeedValue * dt
            moved = true
        end
    end

    if S.hipHeight then
        local y = mv.Root.Position.Y
        if not S.hipBaseY then S.hipBaseY = y end
        local target = S.hipBaseY + S.hipValue
        local d = target - y
        if math.abs(d) > 0.02 then
            mv.Root.CFrame = mv.Root.CFrame + Vector3.new(0, d * 0.35, 0)
            moved = true
        end
    elseif S.hipBaseY then
        S.hipBaseY = nil
    end

    if moved and mv.RealRoot then
        mv.RealRoot.CFrame = mv.Root.CFrame
    end
end

