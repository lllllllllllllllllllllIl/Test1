local function bestPassTarget()
    local root = myRoot()
    if not root then return nil end
    local best, bestScore = nil, -math.huge
    for _, pkt in ipairs(allPackets()) do
        if not isOpponent(pkt) and pkt ~= myPkt() then
            local r = pktRoot(pkt)
            if r then
                local closest = math.huge
                for _, op in ipairs(allPackets()) do
                    if isOpponent(op) then
                        local orr = pktRoot(op)
                        if orr then
                            local dd = (orr.Position - r.Position).Magnitude
                            if dd < closest then closest = dd end
                        end
                    end
                end
                local passDist = (r.Position - root.Position).Magnitude
                -- lane check: a defender standing on the straight line between
                -- us and the mate kills the pass no matter how open they look
                local lane = 1
                local dir = r.Position - root.Position
                dir = Vector3.new(dir.X, 0, dir.Z)
                if dir.Magnitude > 0.5 then
                    local u = dir.Unit
                    for _, op in ipairs(allPackets()) do
                        if isOpponent(op) then
                            local orr = pktRoot(op)
                            if orr then
                                local rel = orr.Position - root.Position
                                rel = Vector3.new(rel.X, 0, rel.Z)
                                local along = rel:Dot(u)
                                if along > 0.5 and along < dir.Magnitude - 0.5 then
                                    local perp = (rel - u * along).Magnitude
                                    if perp < 3.5 then
                                        lane = 0.25
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
                -- open mate first, short pass second, clear lane multiplies
                local score = math.min(closest, 40) * lane - passDist * 0.35
                if score > bestScore then best, bestScore = pkt, score end
            end
        end
    end
    return best
end

-- Flat distance from us to the rim we are attacking. This is the gate RH2's
-- farm uses (distToRim) and the reason the old REC shooter pulled from
-- half-court: nothing ever checked it.
local function distToMyGoal()
    local root = myRoot()
    if not root then return nil end
    local g = goalPosition()
    if not g then
        -- the Goal attribute is not always populated (lobby, between quarters).
        -- Fall back to the same team->hoop mapping the dunk code uses so the
        -- range gate never silently disables shooting.
        local pkt = myPkt()
        local isHome = pkt and pktAttr(pkt, "HomeTeam")
        g = isHome and Vector3.new(64.5, 9.9, -23.2)
                    or  Vector3.new(-48.7, 12.5, -23.2)
    end
    local a = Vector3.new(g.X, 0, g.Z)
    local b = Vector3.new(root.Position.X, 0, root.Position.Z)
    return (a - b).Magnitude
end

-- Shared shot gate for Auto Shoot and the REC farm. Returns false plus a
-- reason string so the debug readout can say why the trigger held fire.
local function shotAllowed()
    local pkt = myPkt()
    if not pkt then S.recShootWhy = "no packet" return false end
    if not pktHasBall(pkt) then S.recShootWhy = "no ball" return false end
    if pktAttr(pkt, "InGame") == false then S.recShootWhy = "not in game" return false end
    if pktAttr(pkt, "CanMove") == false then S.recShootWhy = "locked" return false end
    local act = pktAttr(pkt, "Action")
    if type(act) == "string" and SHOOT_ACTIONS[act] then
        S.recShootWhy = "action " .. act
        return false
    end
    local d = distToMyGoal()
    if not d then S.recShootWhy = "no goal" return false end
    local minR = S.recShootMinRange or 0
    local maxR = S.recShootMaxRange or 55
    if d < minR then
        S.recShootWhy = string.format("too close (%.0f)", d)
        return false
    end
    if d > maxR then
        S.recShootWhy = string.format("out of range (%.0f/%.0f)", d, maxR)
        return false
    end
    S.recShootWhy = string.format("ok (%.0f)", d)
    return true, d
end

-- ============================================================================
-- DRIBBLE MACROS
-- The game never sends a move name over the wire. Its input layer builds a
-- combo string out of the dribble keys and fires:
--     InputService.Dribble:Fire(combo, sprinting, moveDirection)
-- The combo -> move table is game config:
--     ReplicatedStorage.Aero.Shared.Config.Game.Dribbling.Input
--     Z = { R = "Crossover", L = "Hesitation" }
-- so the SAME combo resolves to a different move depending on which side the
-- stick points. An empty string means that side does nothing. Read live, with
-- a hardcoded copy as the fallback if the module refuses to load.
local CAS = game:GetService("ContextActionService")
local DribbleTable = {}
local DribbleNames = {}

do
    local cfgInput = nil
    pcall(function()
        local shared = AeroFolder and AeroFolder:FindFirstChild("Shared")
        local config = shared and shared:FindFirstChild("Config")
        local gameCfg = config and config:FindFirstChild("Game")
        local dribbleCfg = gameCfg and gameCfg:FindFirstChild("Dribbling")
        if dribbleCfg then
            local ok, res = pcall(require, dribbleCfg)
            if ok and type(res) == "table" then cfgInput = res.Input end
        end
    end)

    if type(cfgInput) ~= "table" then
        cfgInput = {
            Z    = { R = "Crossover",        L = "Hesitation" },
            C    = { R = "Hesitation",       L = "Crossover" },
            ZZ   = { R = "Tween",            L = "DoubleCrossover" },
            CC   = { R = "DoubleCrossover",  L = "Tween" },
            ZX   = { R = "",                 L = "BehindBack" },
            CX   = { R = "BehindBack",       L = "" },
            ZXC  = { R = "",                 L = "Spin" },
            CXZ  = { R = "Spin",             L = "" },
            H    = { R = "SwitchHand",       L = "SwitchHand" },
            X    = { R = "StepBack",         L = "StepBack" },
            XZ   = { R = "DoubleBehindBack", L = "DoubleBehindBack" },
            XC   = { R = "DoubleBehindBack", L = "DoubleBehindBack" },
            XX   = { R = "SnatchBack",       L = "SnatchBack" },
            VV   = { R = "Combo",            L = "Combo" },
            VC   = { R = "Breakdown",        L = "Breakdown" },
            VZ   = { R = "Breakdown",        L = "Breakdown" },
            V    = { R = "HalfSpin",         L = "HalfSpin" },
        }
    end

    local seen = {}
    for combo, sides in pairs(cfgInput) do
        if type(sides) == "table" and type(sides.R) == "string" then
            for _, side in ipairs({ "R", "L" }) do
                local name = sides[side]
                if type(name) == "string" and name ~= "" and not seen[name] then
                    seen[name] = true
                    DribbleTable[#DribbleTable + 1] = { Move = name, Combo = combo, Side = side }
                    DribbleNames[#DribbleNames + 1] = name
                end
            end
        end
    end
    table.sort(DribbleNames)
end

local function dribbleEntry(moveName)
    for _, e in ipairs(DribbleTable) do
        if e.Move == moveName then return e end
    end
end

-- The side comes from the stick, so an L-only move needs a leftward vector and
-- a both-sides move is happy either way. Character right vector stands in for
-- the movement direction the game would have passed.
local function dribbleDirection(side)
    local root = myRoot()
    local cf = root and root.CFrame
    if not cf then return Vector3.new(0, 0, -1) end
    if side == "R" then return cf.RightVector end
    if side == "L" then return -cf.RightVector end
    return cf.LookVector
end

local function playDribble(moveName)
    local e = dribbleEntry(moveName)
    if not e then return false end
    return send(InputS, "Dribble", e.Combo, false, dribbleDirection(e.Side))
end

-- Four macro slots. The key is bound through ContextActionService above the
-- game's own input priority and returns Sink, so the press never reaches the
-- game -- whatever that key normally did on the court is replaced.
local DribbleMacros = {
    { Move = "Spin",       Key = "Z" },
    { Move = "Crossover",  Key = "None" },
    { Move = "SnatchBack", Key = "None" },
    { Move = "HalfSpin",   Key = "None" },
}
local DRIBBLE_MACRO_PRIORITY = 3000
local dribbleActions = {}

local function bindDribbleMacro(i)
    local old = dribbleActions[i]
    if old then pcall(function() CAS:UnbindAction(old) end) end
    dribbleActions[i] = nil

    local m = DribbleMacros[i]
    if not m or not m.Key or m.Key == "None" then return end
    local code = Enum.KeyCode[m.Key]
    if not code then return end

    local actionName = "PBDribbleMacro" .. i
    dribbleActions[i] = actionName
    CAS:BindActionAtPriority(actionName, function(_, state)
        if state == Enum.UserInputState.Begin then
            playDribble(m.Move)
        end
        return Enum.ContextActionResult.Sink
    end, false, DRIBBLE_MACRO_PRIORITY, code)
end

local function unbindDribbleMacros()
    for i = 1, #DribbleMacros do
        local a = dribbleActions[i]
        if a then pcall(function() CAS:UnbindAction(a) end) end
        dribbleActions[i] = nil
    end
end

-- Inbound detection. The court controller carries the authoritative flag;
-- the character Action string and the model marker are the cheap fallbacks.
local function isInbounding(pkt)
    local cc = CourtCtrl and CourtCtrl.CurrentCourt
    if cc and cc.Inbounding == true then return true end
    if not pkt then return false end
    local act = tostring(pktAttr(pkt, "Action") or "")
    if act == "Inbounding" or act == "Inbound" then return true end
    local m = pkt.model
    if m and m:FindFirstChild("Currently_Inbounding") then return true end
    return false
end

-- Throw-in spot for our inbound. The court build parks a StartPassPosition
-- part at the line; the Court object sometimes carries its own coordinate.
-- Falls back to the ball itself, which the server hands to the thrower.
local function vecFrom(v)
    if typeof(v) == "Vector3" then return v end
    if type(v) == "table" and type(v.Position) == "Vector3" then return v.Position end
    if typeof(v) == "Instance" and v:IsA("BasePart") then return v.Position end
    return nil
end

local function inboundSpot(pkt)
    local cc = CourtCtrl and CourtCtrl.CurrentCourt
    if type(cc) == "table" then
        for _, k in ipairs({ "InboundPosition", "InboundSpot", "ThrowIn", "StartPassPosition" }) do
            local p = vecFrom(cc[k])
            if p then return p end
        end
    end
    local part = WS:FindFirstChild("StartPassPosition")
    if part and part:IsA("BasePart") then return part.Position end
    local b = pkt and pktAttr(pkt, "Basketball")
    if typeof(b) == "Instance" and b:IsA("BasePart") then return b.Position end
    return nil
end

-- Fire a pass at the best available mate. `Player` is the character model name
-- because that is exactly what the game's own Passing controller sends.
local function recTryPass(reason, passType)
    local pkt = myPkt()
    if not pkt or not pktHasBall(pkt) then return false end
    -- the game refuses to start a pass while the previous one is still in the
    -- Passing state; firing into that just burns the attempt
    if tostring(pktAttr(pkt, "Action") or "") == "Passing" then return false end
    local mate = bestPassTarget()
    if not mate then return false end
    local name = pktName(mate)
    if not name then return false end
    local pt = passType or S.recPassType or 1
    local now = os.clock()
    S.recLastPass = now
    S.recPassPending = now
    S.recPassTries = (S.recPassTries or 0) + 1
    S.recPassTarget = name
    S.recPassToken = (S.recPassToken or 0) + 1
    S.recState = reason
    S.statPasses = (S.statPasses or 0) + 1
    send(InputS, "Pass", { Player = name, PassType = pt })
    if S.recDebug then
        notify("REC", "pass -> " .. name .. " type " .. tostring(pt))
    end
    return true
end

-- Pass watchdog: if the ball is still in our hands a moment after the pass the
-- server dropped it (dead lane, wrong name, action gate). Escalate - retry the
-- same mate, then lob it, then give up for a beat and re-plan.
local function recPassWatch(pkt)
    if not S.recPassPending or S.recPassPending == 0 then return end
    if not pkt then return end
    if not pktHasBall(pkt) then
        S.recPassPending = 0
        S.recPassTries = 0
        S.recPassTarget = nil
        return
    end
    local now = os.clock()
    if now - S.recPassPending < 0.45 then return end
    S.recPassPending = 0
    if (S.recPassTries or 0) >= 3 then
        S.recPassTries = 0
        S.recLastPass = now + 0.4
        S.recState = "pass blocked"
        return
    end
    recTryPass("pass retry (" .. tostring(S.recPassTries) .. ")", S.recPassTries >= 2 and 4 or 1)
end

-- Face-to-face pursuit shared by REC defence and Auto Guard. We live on a
-- tight ring between the man and the basket we defend, leading his velocity
-- so a cut closes into us instead of away, and we never stop pressing: the
-- old version halted input the moment it landed on the anchor, which is what
-- let him just keep walking and leave us standing.
local function guardMove(oroot, distToCarrier)
    local root = myRoot()
    if not root or not oroot then return false end
    local carrierPos = oroot.Position
    local vel = oroot.AssemblyLinearVelocity
    local vx, vz = 0, 0
    if vel then vx, vz = vel.X, vel.Z end
    local pkt = myPkt()
    local isHome = pkt and pktAttr(pkt, "HomeTeam")
    if S.guardFlip then isHome = not isHome end
    local myBasket = isHome
        and Vector3.new(-48.7, 12.5, -23.2)   -- Hoop1 (HomeTeam defends)
        or  Vector3.new(64.5,  9.9, -23.2)    -- Hoop2 (AwayTeam defends)

    local standoff = S.guardStandoff or 2.0
    local leadT = S.guardLead or 0.18

    -- Which basket are we defending? The rim closest to the man with the ball is
    -- the one he is attacking, so that is the one we stand between him and.
    -- Asking the Hoops controller beats guessing off HomeTeam: with the team
    -- guess the anchor lands on the attacker's back instead of standing him up.
    local HOOP_A = Vector3.new(-48.7, 12.5, -23.2)
    local HOOP_B = Vector3.new(64.5,  9.9, -23.2)
    local myBasket
    if HoopsCtrl and HoopsCtrl.FindClosestGoal then
        local ok, h = pcall(function() return HoopsCtrl:FindClosestGoal(carrierPos) end)
        if ok and h then
            if typeof(h) == "Instance" and h:IsA("BasePart") then myBasket = h.Position
            elseif typeof(h) == "Vector3" then myBasket = h
            elseif type(h) == "table" and h.Position then myBasket = h.Position end
        end
    end
    if not myBasket then
        local attack = goalPosition()
        if attack then
            myBasket = ((attack - HOOP_A).Magnitude <= (attack - HOOP_B).Magnitude) and HOOP_B or HOOP_A
        else
            myBasket = isHome and HOOP_A or HOOP_B
        end
    end

    local flatSpeed = math.sqrt(vx * vx + vz * vz)

    -- Lead grows with how fast he is moving: a sprint gets a longer lead, a
    -- standstill gets none, so the anchor never sits on a stale spot.
    local lead = leadT * (1 + math.clamp(flatSpeed / 14, 0, 1.2))
    local pred = Vector3.new(carrierPos.X + vx * lead, 0, carrierPos.Z + vz * lead)

    local axis = Vector3.new(myBasket.X - pred.X, 0, myBasket.Z - pred.Z)
    if axis.Magnitude < 0.01 then axis = Vector3.new(1, 0, 0) end
    axis = axis.Unit
    local side = Vector3.new(-axis.Z, 0, axis.X)

    local toMe = Vector3.new(root.Position.X - carrierPos.X, 0, root.Position.Z - carrierPos.Z)
    local myDepth = toMe.X * axis.X + toMe.Z * axis.Z   -- + means we are goal-side
    local latVel = vx * side.X + vz * side.Z            -- + he slides to our right
    local alongVel = vx * axis.X + vz * axis.Z          -- + he drives at our rim

    -- Lateral mirror: he slides left, we slide left with him at the same beat.
    local latShade = math.clamp(latVel * (lead + 0.14), -4.5, 4.5)

    -- Backpedal: he is moving away from the rim he attacks, so close the gap
    -- instead of letting him walk us backwards into the paint.
    local retreat = math.clamp(-alongVel, 0, 12)
    local off = standoff
    if retreat > 0.4 then
        off = math.clamp(standoff - retreat * 0.18, 0.9, standoff)
        latShade = latShade * 0.7
    end

    if myDepth < standoff * 0.5 then
        -- beaten: swing around his hip instead of pushing through his back,
        -- then take the shortest route onto his goal side
        off = standoff + 1.0
        local latMe = toMe.X * side.X + toMe.Z * side.Z
        latShade = math.clamp(latVel * (lead + 0.05) + (latMe >= 0 and 3.5 or -3.5), -6, 6)
    end
    local aXZ = pred + axis * off + side * latShade
    local anchor = Vector3.new(aXZ.X, root.Position.Y, aXZ.Z)
    S.guardAnchor = anchor
    S.guardPress = retreat > 0.4 and off or nil

    -- Plant on the anchor instead of sliding on a stale move vector.
    local dAnchor = (anchor - root.Position).Magnitude
    if dAnchor > 0.7 then
        moveTowards(anchor, 1)
    else
        stopMoving()
    end

    -- Face-to-face: chest always pointed at him in guarding range. 15 degree
    -- deadzone and a 60ms gate so it never fights the walk rotation into
    -- jitter.
    local d = distToCarrier or (carrierPos - root.Position).Magnitude
    if d <= 20 then
        local nowT = tick()
        if nowT - (S.guardFaceAt or 0) > 0.06 then
            local look = Vector3.new(carrierPos.X - root.Position.X, 0,
                                     carrierPos.Z - root.Position.Z)
            if look.Magnitude > 0.4 then
                local fwd = root.CFrame.LookVector
                fwd = Vector3.new(fwd.X, 0, fwd.Z)
                if fwd.Magnitude > 0.01 then
                    local ang = math.deg(math.acos(
                        math.clamp(fwd.Unit:Dot(look.Unit), -1, 1)))
                    if ang > 15 then
                        S.guardFaceAt = nowT
                        pcall(function()
                            root.CFrame = CFrame.lookAt(root.Position,
                                root.Position + look.Unit)
                        end)
                    end
                end
            end
        end
    end
    return true
end

