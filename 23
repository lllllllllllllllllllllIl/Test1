local function celebList()
    local out = {}
    local src = GameCfg or CelebsConfig
    if type(src) == "table" then
        for name, v in pairs(src) do
            if type(name) == "string" and type(v) == "table" then out[#out + 1] = name end
        end
        table.sort(out)
    end
    if #out == 0 then out = { "Flex" } end
