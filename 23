--========================================================--
--  AUTO PERFECT SCRIPT (UPDATED TO USE SLIDER)
--========================================================--
local function setupAutoPerfect()
    local char = getChar()
    if not char then return end

    char:GetAttributeChangedSignal("meterOffset"):Connect(function()
        if not Toggles.AutoPerfect.Value then return end

        local offset = char:GetAttribute("meterOffset")
        if not offset then return end

        local trigger = Options.MeterOffset.Value

        -- Vertical Meter
        if char.HumanoidRootPart.VerticalMeter.Enabled == true then
            if offset.Y <= trigger then
                RS.Aero.AeroRemoteServices.InputService.Shoot:FireServer({Shoot = false})
            end

        -- Bat Meter
        elseif char.HumanoidRootPart.BatMeter.Enabled == true then
            if offset.Y <= trigger then
                RS.Aero.AeroRemoteServices.InputService.Shoot:FireServer({Shoot = false})
            end

        -- Rocket Meter
        elseif char.HumanoidRootPart.RocketMeter.Enabled == true then
            if offset.Y <= trigger then
                RS.Aero.AeroRemoteServices.InputService.Shoot:FireServer({Shoot = false})
            end

        -- Hoop Meter
        elseif char.Head.HoopMeter.Enabled == true then
            if offset.Y >= trigger then
                RS.Aero.AeroRemoteServices.InputService.Shoot:FireServer({Shoot = false})
            end

        -- Roblox Meter
        elseif char.Head.RobloxMeter.Enabled == true then
            if offset.X >= trigger then
                RS.Aero.AeroRemoteServices.InputService.Shoot:FireServer({Shoot = false})
            end

        -- Default fallback
        else
            if offset.Y <= trigger then
                RS.Aero.AeroRemoteServices.InputService.Shoot:FireServer({Shoot = false})
            end
        end
    end)
end

-- Initial setup
setupAutoPerfect()

-- Re-setup on respawn
player.CharacterAdded:Connect(function()
    task.wait(1)
    setupAutoPerfect()
end)

