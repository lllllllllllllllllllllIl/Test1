local function httpPost(url, body)
    local headers = { ["Content-Type"] = "application/json" }
    local senders = {
        function() return request({ Url = url, Method = "POST", Headers = headers, Body = body }) end,
        function() return http_request({ Url = url, Method = "POST", Headers = headers, Body = body }) end,
        function() return syn.request({ Url = url, Method = "POST", Headers = headers, Body = body }) end,
        function() return http.request({ Url = url, Method = "POST", Headers = headers, Body = body }) end,
    }
    for _, fn in ipairs(senders) do
        local ok = pcall(fn)
        if ok then return true end
    end
    return false
end

local function webhookReady()
    local url = tostring(S.webhookURL or ""):gsub("%s", "")
    if url == "" then return nil, "set a webhook URL first" end
    if not url:find("discord%.com/api/webhooks/") then return nil, "not a discord webhook URL" end
    return url
end

local function sendWebhookPayload(payload, label)
    local url, why = webhookReady()
    if not url then S.webhookStatus = tostring(why) return false end
    local ok, body = pcall(function() return Http:JSONEncode(payload) end)
    if not ok then S.webhookStatus = "encode failed" return false end
    local sent = httpPost(url, body)
    S.webhookStatus = tostring(label) .. (sent and ": sent" or ": FAILED")
    S.webhookLastAt = os.clock()
    return sent
end

local function recStatsRead()
    local pg = me:FindFirstChild("PlayerGui")
    local st = pg and pg:FindFirstChild("Statsheet")
    local main = nil
    if st then
        for _, d in ipairs(st:GetDescendants()) do
            if d.Name == "Main" and d:IsA("Frame") then main = d break end
        end
    end
    if not main then S.liveRowFound = false return false end

    local function num(parent, name)
        local c = parent and parent:FindFirstChild(name)
        if not c or not c:IsA("TextLabel") then return nil end
        return tonumber((c.Text or ""):match("-?%d+"))
    end
    local function txt(parent, name)
        local c = parent and parent:FindFirstChild(name)
        if not c or not c:IsA("TextLabel") then return nil end
        return c.Text
    end

    local hdr = main:FindFirstChild("Header")
    local score = hdr and hdr:FindFirstChild("Score")
    if score then
        S.liveHomeScore = num(score, "HomeScore") or S.liveHomeScore or 0
        S.liveAwayScore = num(score, "AwayScore") or S.liveAwayScore or 0
    end
    local q = hdr and hdr:FindFirstChild("Quarters")
    if q then
        local hr, ar = q:FindFirstChild("HomeRow"), q:FindFirstChild("AwayRow")
        for i = 1, 4 do
            local a, b = num(hr, tostring(i)), num(ar, tostring(i))
            if a then S.quarterHome[i] = a end
            if b then S.quarterAway[i] = b end
        end
    end

    local gGui = pg and pg:FindFirstChild("GradeUI")
    local gMain = gGui and gGui:FindFirstChild("MainFrame")
    local gBox = gMain and gMain:FindFirstChild("Grade")
    local gTxt = gBox and gBox:FindFirstChild("Grade")
    if gTxt and gTxt:IsA("TextLabel") and gTxt.Text ~= "" then S.liveGrade = gTxt.Text end

    local row, side = nil, ""
    for _, s in ipairs({ "Home", "Away" }) do
        local f = main:FindFirstChild(s)
        local list = f and f:FindFirstChild("List")
        if list then
            for _, r in ipairs(list:GetChildren()) do
                local pn = r:FindFirstChild("PlayerName")
                if pn and pn:IsA("TextLabel") and pn.Text == me.Name then row, side = r, s end
            end
        end
    end
    if not row then S.liveRowFound = false return false end
    S.liveRowFound = true
    S.liveSide = side
    S.livePts = num(row, "PTS") or 0
    S.liveAst = num(row, "AST") or 0
    S.liveReb = num(row, "REB") or 0
    S.liveBlk = num(row, "BLK") or 0
    S.liveStl = num(row, "STL") or 0
    S.liveTov = num(row, "TOV") or 0
    S.liveFls = num(row, "FLS") or 0
    S.livePlusMinus = num(row, "+/-") or 0
    S.liveFgs = txt(row, "FGS") or "0/0"
    S.live3ps = txt(row, "3PS") or "0/0"
    S.liveFts = txt(row, "FTS") or "0/0"
    return true
end

local function recStatsSnapshot()
    local mins = 0
    if S.recMatchStartAt and S.recMatchStartAt > 0 then
        mins = (os.clock() - S.recMatchStartAt) / 60
    end
    local team = tonumber(S.liveHomeScore) or 0
    local opp = tonumber(S.liveAwayScore) or 0
    if S.liveSide == "Away" then team, opp = opp, team end
    local qp = {}
    for i = 1, 4 do
        qp[#qp + 1] = string.format("Q%d %d-%d", i, S.quarterHome[i] or 0, S.quarterAway[i] or 0)
    end
    return {
        player = me.Name .. " (" .. tostring(me.DisplayName) .. ")",
        place = tostring(game.PlaceId),
        state = tostring(S.recState),
        team_score = team,
        opp_score = opp,
        points = S.livePts or 0,
        assists = S.liveAst or 0,
        rebounds = S.liveReb or 0,
        steals = S.liveStl or 0,
        blocks = S.liveBlk or 0,
        turnovers = S.liveTov or 0,
        fouls = S.liveFls or 0,
        plusminus = S.livePlusMinus or 0,
        fgs = S.liveFgs or "0/0",
        tps = S.live3ps or "0/0",
        fts = S.liveFts or "0/0",
        grade = S.liveGrade or "-",
        side = S.liveSide ~= "" and S.liveSide or "?",
        minutes = string.format("%.1f", mins),
        quarters = table.concat(qp, " · "),
        live = S.liveRowFound,
    }
end

