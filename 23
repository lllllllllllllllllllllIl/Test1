    armShot()
    send(InputS, "Shoot", { Shoot = true, Input = "E" })
end

-- ============================================================================
-- SMART REC FARM  (RH2-ported logic for Practical Basketball)
-- Possession debounce * open spot scoring * stall watchdog * paint 3s
-- * score-and-sprint-back * inbound leak-out * closeout sidestep
-- * double-team force-pass
-- ============================================================================

-- Safe 3PT arc spots on each team's attacking half (Y=2, inside court)
-- Live hoop geometry: Hoop1 = (-48.7, 12.5, -23.2), Hoop2 = (64.5, 9.9, -23.2)
-- Away attacks Hoop2 (+X side), Home attacks Hoop1 (-X side).
local REC_SPOTS_AWAY = {
    Vector3.new(29.20, 2, -19.89),  -- Top Key
    Vector3.new(34.87, 2,   0.75),  -- Right Wing
    Vector3.new(33.44, 2, -43.91),  -- Left Wing
}
-- Home spots are the away spots mirrored through Hoop1. The old table sat at
-- X = -105..-110, which is 56 studs BEHIND the baseline - off the court, so
-- home-team farming walked out of bounds and never got a shot off.
local REC_SPOTS_HOME = {
    Vector3.new(-13.40, 2, -19.69),  -- Top Key
    Vector3.new(-19.07, 2,   0.95),  -- Right Wing
    Vector3.new(-17.64, 2, -43.71),  -- Left Wing
}
-- Defensive spots sit between the rim we defend and mid-court.
-- Home defends Hoop1 (negative X), away defends Hoop2 (positive X).
local REC_DEF_AWAY = {
    Vector3.new(32.0, 2, -19.69),
    Vector3.new(27.0, 2,   0.95),
    Vector3.new(27.0, 2, -43.71),
}
local REC_DEF_HOME = {
    Vector3.new(-16.0, 2, -19.69),
    Vector3.new(-11.0, 2,   0.95),
    Vector3.new(-11.0, 2, -43.71),
}

-- -- Helpers ------------------------------------------------------------------

-- Returns all opponent packets with their root positions
local function recGetOpps()
    local out = {}
    for _, pkt in ipairs(allPackets()) do
        if isOpponent(pkt) then
            local r = pktRoot(pkt)
            if r then out[#out + 1] = { pkt = pkt, pos = r.Position } end
        end
    end
    return out
end

-- Returns all teammate packets (excluding self)
local function recGetMates()
    local me = myPkt()
    local out = {}
    for _, pkt in ipairs(allPackets()) do
        if pkt ~= me and not isOpponent(pkt) then
            local r = pktRoot(pkt)
            if r then out[#out + 1] = { pkt = pkt, pos = r.Position } end
        end
    end
    return out
end

-- Nearest opponent distance to a world position
local function recNearestOppDist(pos, opps)
    local best = math.huge
    for _, e in ipairs(opps) do
        local d = (e.pos - pos).Magnitude
        if d < best then best = d end
    end
    return best
end

-- Nearest teammate distance to a world position (excluding ball holder)
local function recNearestMateDist(pos, mates, ballHolder)
    local best = math.huge
    for _, e in ipairs(mates) do
        if e.pkt ~= ballHolder then
            local d = (e.pos - pos).Magnitude
            if d < best then best = d end
        end
    end
    return best
end

-- Estimate defender ETA to position (studs / ~16 studs/s run speed)
local function recDefETA(pos, opps)
    local best = math.huge
    for _, e in ipairs(opps) do
        local d = (e.pos - pos).Magnitude
        local eta = d / 16
        if eta < best then best = eta end
    end
    return best
end

-- Score a 3PT arc spot: higher = more open / better
-- Penalizes: defender proximity, their ETA vs our ETA, teammate crowding
-- Bonuses: defender moving away, corner spots (more distance from basket)
local function recScoreSpot(sp, myPos, opps, mates, ballHolder)
    -- teammate spacing veto: don't stack on a mate
    local mateD = recNearestMateDist(sp, mates, ballHolder)
    if mateD < 6 then return -math.huge end

    local d1 = recNearestOppDist(sp, opps)
    local score = math.min(d1, 22)  -- defender distance, capped

    -- closeout ETA penalty: defender arriving before or soon after us
    local defETA  = recDefETA(sp, opps)
    local myETA   = (sp - myPos).Magnitude / 16
    if defETA < myETA then
        score = score - 14  -- they get there first
    elseif defETA < myETA + 1.2 then
        score = score - 5   -- close race
    end
    -- defender too close right now
    if d1 < 5.5 then score = score - 20 end

    -- teammate spacing penalty (secondary defenders rotate)
    if mateD < 10 then score = score - (10 - mateD) * 0.6 end

    -- travel cost when not in transition: don't prefer far spots unnecessarily
    score = score - (sp - myPos).Magnitude * 0.08

    return score
end

-- Pick the best open 3PT spot for our attacking half
local function recBestOpenSpot(myPos, opps, mates, ballHolder)
    local pkt = myPkt()
    local isHome = pkt and pktAttr(pkt, "HomeTeam")
    local spots = isHome and REC_SPOTS_HOME or REC_SPOTS_AWAY

    local bestSp, bestScore = spots[1], -math.huge
    for _, sp in ipairs(spots) do
        local s = recScoreSpot(sp, myPos, opps, mates, ballHolder)
        if s > bestScore then bestScore = s; bestSp = sp end
    end
    return bestSp
end

-- Pick the best defensive spot
local function recBestDefSpot(myPos)
    local pkt = myPkt()
    local isHome = pkt and pktAttr(pkt, "HomeTeam")
    local spots = isHome and REC_DEF_HOME or REC_DEF_AWAY
    local bestSp, bestD = spots[1], math.huge
    for _, sp in ipairs(spots) do
        local d = (sp - myPos).Magnitude
        if d < bestD then bestSp = sp; bestD = d end
    end
    return bestSp
end

-- Forward declaration: recFarmTick below calls this, the body is further down.
-- Without the local here the call resolved to a nil global and the whole
-- team-possession branch (inbound handling included) errored out.
local teammateBallCarrier

-- Stable possession via debounce (0.15s for gain, 0.4s for transition)
-- Returns "me" / "team" / "enemy" / "loose"
local function recUpdatePossession(now)
    local pkt = myPkt()
    local raw
    if pktHasBall(pkt) then
        raw = "me"
    elseif teammateBallCarrier() then
        raw = "team"
    else
        local opp = nearestOpponent(200, true)
        if opp then
            raw = "enemy"
        else
            local ball = looseBall(200)
            if ball then raw = "loose" else raw = "unknown" end
        end
    end

    -- debounce: require consistency for a brief window before committing
    if raw ~= S.recPossCandidate then
        S.recPossCandidate = raw
        S.recPossCandidateSince = now
    end

    local holdTime = (raw == "me") and 0.08 or (raw == "unknown" and 0.5 or 0.18)
    if now - S.recPossCandidateSince >= holdTime then
        local prev = S.recPossStable
        S.recPossStable = raw
        -- rebound: we came out of a loose ball with it in our hands
        if raw == "me" and prev == "loose" then
            S.statRebounds = (S.statRebounds or 0) + 1
        end
    end

    return S.recPossStable
end

-- Check if we're inside the paint (approximate box)
local function recInPaint(pos)
    -- Paint area approx: Away team paint near Hoop1 (positive X end)
    -- Home team paint near Hoop2 (negative X end)
    local pkt = myPkt()
    local isHome = pkt and pktAttr(pkt, "HomeTeam")
    if isHome then
        -- Home attacks Hoop2 side, paint around x=-51 to -71, z=-35 to -8
        return pos.X > -71 and pos.X < -51 and pos.Z > -35 and pos.Z < -5
    else
        -- Away attacks Hoop1 side, paint around x=60 to 80, z=-35 to -8
        return pos.X > 57 and pos.X < 80 and pos.Z > -35 and pos.Z < -5
    end
end

-- Read score for our team from game stats (best-effort, pcall guarded)
local function recReadMyScore()
    local score = 0
    pcall(function()
        local ss = WS:FindFirstChild("ScoreSystem") or WS:FindFirstChild("Scores")
        if ss then
            local mine = myPkt()
            local isHome = mine and pktAttr(mine, "HomeTeam")
            local key = isHome and "HomeScore" or "AwayScore"
            score = ss:GetAttribute(key) or 0
        end
    end)
    return score
end

local function recReadEnemyScore()
    local score = 0
    pcall(function()
        local ss = WS:FindFirstChild("ScoreSystem") or WS:FindFirstChild("Scores")
        if ss then
            local mine = myPkt()
            local isHome = mine and pktAttr(mine, "HomeTeam")
            local key = isHome and "AwayScore" or "HomeScore"
            score = ss:GetAttribute(key) or 0
        end
    end)
    return score
end

-- Court bounds (generous box around the playable floor). Anything outside it
-- is out of bounds or someone else's inbound lane - the farm must never walk
-- there. Kept 4 studs loose on each edge so we never hug a line either.
local function inCourt(pos)
    if not pos then return true end
    return pos.X >= -66 and pos.X <= 86
        and pos.Z >= -56 and pos.Z <= 8
end

-- Man-defense piece shared by the two spots an enemy inbound shows up
-- (the "enemy" possession read and the "loose" ball read): pick the closest
-- opponent OTHER than the thrower, hold the guard standoff on him, steal only
-- once settled, contest any shot. Never key on the thrower.
local function recGuardInbound(now, myPos, opps, throwerPkt)
    local best, bestD = nil, math.huge
    for _, e in ipairs(opps) do
        if e.pkt ~= throwerPkt and e.pos then
            local dme = (e.pos - myPos).Magnitude
            if dme < bestD then best, bestD = e, dme end
        end
    end
    if not best then
        -- every defender is out of bounds with the thrower: hold the slot,
        -- never walk into the lane hunting for a target
        S.recState = "their inbound: holding court"
        stopMoving()
        return
    end
    S.recGuardTarget = best.pkt
    local r = pktRoot(best.pkt)
    local dg = (r and (r.Position - myPos).Magnitude) or bestD
    S.recState = "their inbound: man (d" .. math.floor(dg) .. ")"
    if not r then stopMoving() return end
    guardMove(r, dg)
    -- pressure stays on OUR assignment: stealing inside their inbound lane is
    -- the violation we are not repeating
    if dg < 3.2 and now - (S.recLastSteal or 0) > 1.2 then
        S.recLastSteal = now
        S.statSteals = (S.statSteals or 0) + 1
        send(InputS, "Steal")
    end
    local act = pktAttr(best.pkt, "Action")
    if S.autoContest and dg < 7 and
        (act == "Shooting" or act == "Dunking" or act == "Gathering") and
        now - (S.lastJump or 0) > 0.9 then
        S.lastJump = now
        send(InputS, "Jump")
    end
end

-- Warmup engagement: the rack markers under Map.Courts.*.Racks are static, so
-- cache their positions once. A free ball parked near a marker is the one
-- unmistakable "warmup ball" signature - a batted-around ball never is.
local rackPoints = nil
local rackPointsAt = 0
local function recRackPoints()
    local now = os.clock()
    if not rackPoints or now - rackPointsAt > 10 then
        local out = {}
        pcall(function()
            local courts = WS:FindFirstChild("Map") and WS.Map:FindFirstChild("Courts")
            if courts then
                for _, h in ipairs(courts:GetDescendants()) do
                    if h.Name == "Racks" then
                        for _, p in ipairs(h:GetChildren()) do
                            if p:IsA("BasePart") then
                                out[#out + 1] = Vector3.new(p.Position.X, p.Position.Y, p.Position.Z)
                            end
                        end
                    end
                end
            end
        end)
        if #out > 0 then
            rackPoints = out
            rackPointsAt = now
        end
    end
    return rackPoints
end

local function recBallOnRack(pos)
    local pts = recRackPoints()
    if not pts then return false end
    for _, p in ipairs(pts) do
        local dx = pos.X - p.X
        local dz = pos.Z - p.Z
        if dx * dx + dz * dz <= 64 then return true end
    end
    return false
end

-- -- Main tick -----------------------------------------------------------------

local recSprintTimer = 0

-- True when at least one teammate is standing clear of every defender: the
-- "Pass to open man" inbound mode waits for this instead of throwing blind.
local function recHasOpenMate(myPos)
    local mates = recGetMates()
    local opps = recGetOpps()
    for _, m in ipairs(mates) do
        local open = true
        for _, e in ipairs(opps) do
            if (e.pos - m.pos).Magnitude < 6 then open = false break end
        end
        if open and (m.pos - myPos).Magnitude <= 45 then return true end
    end
    return false
end

local function recFarmTick()
    if not S.recFarm then return end

    local now = os.clock()

    -- Built-in auto sprint: re-assert on a 0.5s pulse. Sprint state resets on
    -- every rush / turnover, and a 1s re-fire leaves stretches of jog between.
    -- Only pulses while the farm is actually driving somewhere, so we are not
    -- sprint-burning stamina while parked.
    recSprintTimer = recSprintTimer or 0
    if S.recFarmSprint and now - recSprintTimer > 0.5 then
        recSprintTimer = now
        S.sprintOn = true
        send(InputS, "Sprint", true)
    end

    local pkt = myPkt()
    if not pkt then S.recState = "no character" stopMoving() return end
    local root = pktRoot(pkt)
    if not root then S.recState = "no root" return end
    local myPos = root.Position

    -- -- Match / queue watcher ------------------------------------------------
    -- Runs first: the InGame edge is the only reliable "game over" signal, and
    -- it must be seen even while the farm is mid-decision.
    pcall(recMatchTick, pkt, now)

    -- -- Possession debounce ---------------------------------------------------
    local poss = recUpdatePossession(now)

    -- -- Score-and-sprint-back: my team scored -> get to D immediately ---------
    local curScore = recReadMyScore()
    if curScore > S.recLastPts and S.recLastPts > 0 then
        S.recLastPts = curScore
        S.recState = "scored! sprinting back"
        local defSp = recBestDefSpot(myPos)
        moveTowards(defSp, 1)
        return
    end
    S.recLastPts = curScore

    -- -- Inbound leak-out: opponent scored -> race to open spot ----------------
    local enemyScore = recReadEnemyScore()
    if enemyScore > S.recEnemyLastPts and S.recEnemyLastPts > 0 then
        S.recEnemyLastPts = enemyScore
        -- find best open spot NOW before defenders set up
        local opps  = recGetOpps()
        local mates = recGetMates()
        S.recLeakTarget = recBestOpenSpot(myPos, opps, mates, nil)
        S.recLeakActive = true
    end
    S.recEnemyLastPts = enemyScore

    if S.recLeakActive and S.recLeakTarget then
        local d = (S.recLeakTarget - myPos).Magnitude
        if d > 5 then
            S.recState = "leak-out (opp scored)"
            moveTowards(S.recLeakTarget, 1)
            return
        else
            S.recLeakActive = false
            S.recLeakTarget = nil
        end
    end

    -- -- Stall watchdog: if we've barely moved for 2.5s while en-route -> replan
    if S.recLastPos and (now - S.recLastPosTick) >= 0.5 then
        local moved = (myPos - S.recLastPos).Magnitude
        if moved < 0.8 then
            if S.recStallSince == 0 then S.recStallSince = now end
            if now - S.recStallSince > 2.5 and now - S.recLastReplan > 2.0 then
                S.recLastReplan = now
                S.recOpenSpotTarget = nil  -- force new spot selection
                stopMoving()
            end
        else
            S.recStallSince = 0
        end
        S.recLastPos = myPos
        S.recLastPosTick = now
    elseif not S.recLastPos then
        S.recLastPos = myPos
        S.recLastPosTick = now
    end

    -- Snapshot opponents and teammates once per tick (used by spot scoring)
    local opps  = recGetOpps()
    local mates = recGetMates()

    -- -- PREGAME WARMUP ---------------------------------------------------------
    -- Engagement: a loose ball parked on a rack, or any free ball on the floor
    -- before the first basket when the court ships no rack markers. Cycle:
    -- walk the ball down -> touch-grab it in range -> carry it to the nearest
    -- real spot for the hoop we attack -> face the rim -> shoot.
    if S.recWarmUp then
        if S.recWarmHold and not pktHasBall(pkt) then S.recWarmHold = false end
        local held = pktHasBall(pkt)
        local ball, ballD = looseBall(200)
        local othersHold = nearestOpponent(200, true) or teammateBallCarrier()
        -- Pregame means "no score on the board and not in a live game". The
        -- box score is the truth here: recReadMyScore() reads scoreboard
        -- attributes that this build does not always populate, which left the
        -- warmup fighting the farm in the middle of a real game.
        local hs = tonumber(S.liveHomeScore or recReadMyScore()) or 0
        local as = tonumber(S.liveAwayScore or recReadEnemyScore()) or 0
        local inLiveGame = pkt and pktAttr(pkt, "InGame") == true
        local pregame = (hs == 0 and as == 0 and not inLiveGame)

        if S.recWarmEngaged then
            -- a real possession by anyone else ends the warmup
            if othersHold or not pregame then
                S.recWarmEngaged = false
                S.recWarmHold = false
                S.recWarmSpot = nil
            end
        elseif pregame and not othersHold and ball then
            -- Any ball in reach engages the warmup. The old 60-stud gate meant
            -- a rack on the far end never started it at all.
            S.recWarmEngaged = true
        end

        if S.recWarmEngaged then
            local goal = goalPosition()
            if held then S.recWarmHold = true end

            -- 1) no ball in hand -> walk it down and touch-grab it. Walking
            -- onto a rack ball does not always register a touch, so pulse the
            -- same firetouchinterest the Ball Magnet uses while in range.
            if not S.recWarmHold then
                if not ball then
                    S.recState = "warmup (waiting for ball)"
                    stopMoving()
                    return
                end
                local d = (ball.Position - myPos).Magnitude
                if d <= 6 and now - (S.recWarmGrabAt or 0) > 0.08 then
                    S.recWarmGrabAt = now
                    if typeof(firetouchinterest) == "function" then
                        pcall(firetouchinterest, root, ball, 0)
                        pcall(firetouchinterest, root, ball, 1)
                    end
                    -- rack builds that gate the ball behind a prompt
                    if typeof(fireproximityprompt) == "function" then
                        local n = 0
                        for _, pr in ipairs(ball:GetDescendants()) do
                            if pr:IsA("ProximityPrompt") and pr.Enabled then
                                pcall(fireproximityprompt, pr)
                                n += 1
                                if n >= 3 then break end
                            end
                        end
                    end
                end
                S.recState = ("warmup (grabbing ball d=%.0f)"):format(d)
                moveTowards(ball.Position, 1)
                return
            end

            -- 2) ball in hand -> a real spot for the hoop we attack
            if not goal then
                S.recState = "warmup holding (no goal)"
                stopMoving()
                return
            end
            local spots = REC_SPOTS_HOME
            if (goal - Vector3.new(64.5, 9.9, -23.2)).Magnitude
                < (goal - Vector3.new(-48.7, 12.5, -23.2)).Magnitude then
                spots = REC_SPOTS_AWAY
            end
            local best, bestD = nil, math.huge
            for _, sp in ipairs(spots) do
                local dd = (sp - myPos).Magnitude
                if dd < bestD then best, bestD = sp, dd end
            end
            if not best then
                S.recState = "warmup holding ball (no spot)"
                stopMoving()
                return
            end
            S.recWarmSpot = best
            S.recWarmGoal = goal

            local dSpot = (best - myPos).Magnitude
            if dSpot > 2.5 then
                S.recState = ("warmup (to spot d=%.0f)"):format(dSpot)
                moveTowards(best, 1)
                return
            end

            -- at the spot: square up to the rim, then shoot on the gap
            local act = tostring(pktAttr(pkt, "Action") or "")
            local flat = Vector3.new(goal.X - myPos.X, 0, goal.Z - myPos.Z)
            if flat.Magnitude > 0.5 then
                pcall(function()
                    root.CFrame = CFrame.lookAt(root.Position, root.Position + flat.Unit)
                end)
            end
            local range = S.recShootMaxRange or 55
            local dist = distToMyGoal() or (goal - myPos).Magnitude
            local gap = S.recWarmShotGap or 2.2
            local busy = (act == "Shooting" or act == "Dunking"
                or act == "Gathering" or S.shotArmed)
            if not busy and dist <= range + 4
                and now - (S.recWarmLastShot or 0) > gap then
                S.recWarmLastShot = now
                S.recWarmMeter = (S.recWarmMeter or 0) + 1
                S.recState = ("warmup shooting #%d"):format(S.recWarmMeter)
                stopMoving()
                shootNow()
            else
                S.recState = "warmup (holding spot)"
                stopMoving()
            end
            return
        end
        -- nothing engaged -> the farm owns the tick
    end

    -- -- FAST BREAK WINDOW ------------------------------------------------------
    -- Grabbed a rebound / loose ball right under our rim -> push it up court at
    -- full speed. A live window beats a one-tick flag because the possession
    -- debounce needs a beat before it commits "me".
    if S.recPrevPoss == "loose" and poss == "me" then
        S.recFastUntil = now + 2.5
    elseif poss == "loose" then
        S.recFastUntil = math.max(S.recFastUntil or 0, now + 1.0)
    end
    S.recPrevPoss = poss

    -- -- INBOUND CONTEXT --------------------------------------------------------
    -- One read covers both sides: who is holding the ball out of bounds. Their
    -- inbound must turn into MAN DEFENSE on the closest non-thrower (never the
    -- carrier - that assignment is what dragged the farm up under their
    -- baseline and their ball). Ours is presentation.
    local teamThrower = nil
    local enemyThrower = nil
    do
        local tc = teammateBallCarrier()
        if tc and isInbounding(tc) then teamThrower = tc end
    end
    local enemyThrowerEntry = nil
    for _, e in ipairs(opps) do
        if isInbounding(e.pkt) then enemyThrower, enemyThrowerEntry = e.pkt, e break end
    end

    -- -- THEIR INBOUND -> man the closest guardable opener ---------------------
    if enemyThrower then
        S.recInPaintSince = 0
        S.recLeakActive = false
        S.recOpenSpotTarget = nil
        recGuardInbound(now, myPos, opps, enemyThrower)
        return
    end

    -- -- OUR INBOUND, ball not in hand yet --------------------------------------
    -- Auto inbound walks us to the throw-in line. With Auto-pass / Hold spot we
    -- stand there instead of drifting back into a farm spot.
    if S.recAutoInbound ~= "Off" and isInbounding(pkt) and not pktHasBall(pkt) then
        local sp = inboundSpot(pkt)
        local dIn = sp and (myPos - sp).Magnitude or 0
        if sp and dIn > 3.0 then
            S.recState = ("inbounding (walking to line d=%.0f)"):format(dIn)
            moveTowards(sp, 1)
        else
            S.recState = "inbounding (at line)"
            stopMoving()
        end
        return
    end

    -- -- I HAVE THE BALL -------------------------------------------------------
    if poss == "me" then
        S.recLeakActive = false  -- cancel leak if we got possession
        local goal = goalPosition()

        -- Inbounding: the thrower stands out of bounds on a 5s clock.
        -- Off -> hold and take it by hand. Auto-pass -> walk to the throw-in
        -- spot, then feed whoever presents (retried until the pass lands).
        -- Hold spot -> walk there and stand, no pass.
        if isInbounding(pkt) then
            S.recInboundSeen = now
            local sp = inboundSpot(pkt)
            local dIn = sp and (myPos - sp).Magnitude or 0
            if S.recAutoInbound == "Off" then
                S.recState = "inbounding (manual - holding)"
                stopMoving()
                return
            end
            if sp and dIn > 3.5 then
                S.recState = ("inbounding (walking to line d=%.0f)"):format(dIn)
                moveTowards(sp, 1)
                return
            end
            if S.recAutoInbound == "Hold spot" then
                S.recState = "inbounding (holding line)"
                stopMoving()
                return
            end
            if now - (S.recInboundLastPass or 0) > 0.3 then
                S.recInboundLastPass = now
                if S.recAutoInbound == "Pass to open man" and not recHasOpenMate(myPos) then
                    S.recState = "inbounding (waiting for an open man)"
                    return
                end
                if recTryPass("inbound pass", 1) then return end
            end
            S.recState = "inbounding (no target)"
            return
        end

        -- Double-team check: 2+ defenders within 9 studs -> force kick-out.
        -- During a fast break the kickout also clears on a body near us, not a
        -- stacked double: transition turnovers are the worst way to die.
        local nearCount = 0
        for _, e in ipairs(opps) do
            if (e.pos - myPos).Magnitude < 9 then nearCount = nearCount + 1 end
        end
        local fast = (S.recFastUntil or 0) > now
        if nearCount >= (fast and 1 or 2) and now - S.recLastPass > 0.4 then
            if recTryPass("kick-out (double team)", 1) then return end
            if not bestPassTarget() then
                S.recState = "kick-out (no target)"
            end
        end

        if goal then
            local nearOpp, nearDist = nearestOpponent(150, false)
            local open = (nearDist or 999) >= S.shootOpenRange

            -- Closeout check: defender breathing on us -> skip the shot, drive
            local closingFast = false
            for _, e in ipairs(opps) do
                if (e.pos - myPos).Magnitude < 5 then closingFast = true break end
            end

            -- Range gate: never pull from outside the configured rim distance
            local canShoot, shotWhy = shotAllowed()

            local fast = (S.recFastUntil or 0) > now
            local shotGap = fast and 0.4 or 1.0
            if open and not closingFast and canShoot
                and not S.shotArmed and now - S.recLastShot > shotGap then
                S.recLastShot = now
                S.recState = fast and "shooting (fast break)" or "shooting (open)"
                stopMoving()
                shootNow()
                return
            end

            -- Tight coverage and no open shot -> pass off
            if nearDist and nearDist < 5 and now - S.recLastPass > (fast and 0.4 or 0.8) then
                if recTryPass("passing (covered)", 1) then return end
            end

            if not S.shotArmed then
                S.recState = (fast and "fast break")
                    or (canShoot and "driving to hoop"
                        or ("driving in (" .. tostring(shotWhy) .. ")"))
                moveTowards(goal, fast and 1.0 or 0.95)
            else
                stopMoving()
            end
            return
        end

        S.recState = "holding ball"
        return
    end

    -- -- TEAM HAS BALL -> smart off-ball movement -------------------------------
    if poss == "team" then
        local tmCarrier = teammateBallCarrier()

        -- Paint 3s violation avoidance: exit paint if in there too long while we don't have ball
        if recInPaint(myPos) then
            if S.recInPaintSince == 0 then S.recInPaintSince = now end
            if now - S.recInPaintSince > 2.2 then
                -- Need to vacate paint
                local clearSp = recBestOpenSpot(myPos, opps, mates, tmCarrier)
                S.recState = "clearing paint (3s)"
                moveTowards(clearSp, 1)
                return
            end
        else
            S.recInPaintSince = 0
        end

        -- Auto-inbound handling: when a teammate is throwing it in, the job is
        -- to PRESENT - get open inside their pass range. Sprinting to the rim
        -- is why the pass never came: 40 studs out is not a legal inbound.
        if tmCarrier then
            local isInb = isInbounding(tmCarrier)
            if S.recAutoInbound ~= "Off" and isInb then
                local ir = pktRoot(tmCarrier)
                local base = ir and ir.Position or myPos
                if S.recAutoInbound == "Auto-pass" then
                    local sp = recBestOpenSpot(myPos, opps, mates, tmCarrier)
                    local target = sp
                    local dir = sp - base
                    dir = Vector3.new(dir.X, 0, dir.Z)
                    if dir.Magnitude > 14 then
                        -- clamp toward the thrower so we stay a reachable target
                        target = base + dir.Unit * 11
                    end
                    S.recInboundSpot = target
                    local flat = Vector3.new(target.X, 0, target.Z)
                        - Vector3.new(myPos.X, 0, myPos.Z)
                    local d = flat.Magnitude
                    S.recState = "presenting for inbound (" .. math.floor(d) .. ")"
                    if d > 2.0 then moveTowards(target, 0.85) else stopMoving() end
                    return
                elseif S.recAutoInbound == "Hold spot" then
                    local sp = recBestOpenSpot(myPos, opps, mates, tmCarrier)
                    local d = (sp - myPos).Magnitude
                    S.recState = "hold spot (inbound)"
                    if d > 4 then moveTowards(sp, 0.75) else stopMoving() end
                    return
                end
            end
        end

        -- Spot behavior, RH2 style: hold your spot while nobody is on you and
        -- only displace when someone closes inside 6 studs. That is the
        -- difference between a farm that shuffles the three spots every half
        -- second and one that stays put and stays open.
        local nearestD = math.huge
        for _, e in ipairs(opps) do
            local dd = (e.pos - myPos).Magnitude
            if dd < nearestD then nearestD = dd end
        end

        local sp = S.recOpenSpotTarget
        local threat = nearestD <= (S.recParkThreat or 6)
        local parked = sp ~= nil
            and (sp - myPos).Magnitude <= 4.5
            and not threat
        local lastReplan = S.recLastReplan or 0
        local needReplan =
            (not sp)
            or (threat and (now - lastReplan) > 0.35)
            or ((not parked) and (now - lastReplan) > 3.0)

        if needReplan then
            if threat then
                -- closeout: slide to the cleanest UNMARKED spot, would-be
                -- farthest spot if all of them are shaded
                local pkt2 = myPkt()
                local isHome2 = pkt2 and pktAttr(pkt2, "HomeTeam")
                local spots2 = isHome2 and REC_SPOTS_HOME or REC_SPOTS_AWAY
                local clean, cleanScore = sp, -math.huge
                for _, spc in ipairs(spots2) do
                    local dOpp = math.huge
                    for _, e in ipairs(opps) do
                        local dd = (e.pos - spc).Magnitude
                        if dd < dOpp then dOpp = dd end
                    end
                    local sScore = dOpp - ((spc - myPos).Magnitude * 0.25)
                    if sScore > cleanScore then clean, cleanScore = spc, sScore end
                end
                S.recOpenSpotTarget = clean
            else
                S.recOpenSpotTarget = recBestOpenSpot(myPos, opps, mates, tmCarrier)
            end
            S.recLastReplan = now
            sp = S.recOpenSpotTarget
        end

        if sp then
            local d = (sp - myPos).Magnitude
            if d <= 4.5 and not threat then
                S.recState = "parked (open)"
                stopMoving()
                return
            end
            if d > 1.5 then
                S.recState = ("slide (contested) d=%.0f"):format(nearestD)
                moveTowards(sp, threat and 1.0 or 0.9)
            else
                S.recState = "parked (open)"
                stopMoving()
            end
        else
            S.recState = "off-ball (no clean spot)"
            stopMoving()
        end
        return
    end

    -- -- OPPONENT HAS BALL -> defend --------------------------------------------
    if poss == "enemy" then
        S.recInPaintSince = 0
        S.recLeakActive   = false
        S.recOpenSpotTarget = nil

        -- MAN-TO-MAN. The assignment survives whether he is holding the ball
        -- or not - re-keying on the carrier every packet turned into "orbit
        -- the ball handler, ignore everyone else". The assignment only drops
        -- when the man is gone from the list or has stepped out of bounds as
        -- the inbound thrower.
        local assign, assignEntry = S.recGuardTarget, nil
        if assign then
            for _, e in ipairs(opps) do
                if e.pkt == assign then assignEntry = e break end
            end
            if not assignEntry or isInbounding(assignEntry.pkt) then
                assign, assignEntry = nil, nil
            end
        end
        if not assign then
            local carrier = nearestOpponent(200, true)
            if carrier and isInbounding(carrier) then carrier = nil end
            assign = carrier
            for _, e in ipairs(opps) do
                if e.pkt == assign then assignEntry = e break end
            end
            assign = assignEntry and assign or nil
        end
        S.recGuardTarget = assign

        if assign then
            local oroot = pktRoot(assign)
            local d = oroot and (oroot.Position - myPos).Magnitude
                or (assignEntry.pos - myPos).Magnitude
            S.recState = "man guarding (d" .. math.floor(d) .. ")"
            if oroot then
                guardMove(oroot, d)
                -- steal cadence is for the man actually holding the rock; the
                -- ball-less assignment gets denied, not mugged
                if pktHasBall(assign) and d < S.guardRange and now - (S.recLastSteal or 0) > 0.45 then
                    S.recLastSteal = now
                    S.statSteals = (S.statSteals or 0) + 1
                    send(InputS, "Steal")
                end
                local act = pktAttr(assign, "Action")
                if S.autoContest and d < 7 and
                    (act == "Shooting" or act == "Dunking" or act == "Gathering") and
                    now - (S.lastJump or 0) > 0.9 then
                    S.lastJump = now
                    send(InputS, "Jump")
                end
            else
                stopMoving()
            end
        else
            S.recState = "defending (holding)"
            stopMoving()
        end
        return
    end

    -- -- LOOSE BALL -> box out / rebound ----------------------------------------
    if poss == "loose" then
        S.recInPaintSince = 0
        local ball = looseBall(120)
        -- Their inbound reads "loose" while the ball sits in the thrower's
        -- hands or is already mid-flight: it is attached to nobody. That exact
        -- gap is what dragged the farm into their inbound lane with Auto
        -- Inbound OFF. Gate on the thrower marker AND the court box.
        if enemyThrower then
            recGuardInbound(now, myPos, opps, enemyThrower)
            return
        end
        if ball and not inCourt(ball.Position) then
            S.recState = "ball out of bounds (holding court)"
            stopMoving()
            return
        end
        if ball then
            -- Chase Rebounds is a real rebound chase, not a box-out: the ball
            -- goes up on a shot, we read where it is going to come down, get
            -- under it, and jump for it. Off means box out only.
            local ballVel = ball.AssemblyLinearVelocity
            local airborne = ball.Position.Y > myPos.Y + 3 or ballVel.Y > 2
            if S.recRebound and airborne then
                -- Ballistic landing prediction. Gravity is read from the world
                -- so a custom-gravity court still lands on the right spot.
                local g = workspace.Gravity
                if not g or g < 1 then g = 621 end
                local p, v = ball.Position, ballVel
                local groundY = myPos.Y
                -- solve p.y + v.y*t - 0.5*g*t^2 = groundY for the positive root
                local t = 0
                local disc = (v.Y * v.Y) + 2 * g * (p.Y - groundY)
                if disc >= 0 then t = (v.Y + math.sqrt(disc)) / g end
                t = math.clamp(t, 0, 3.5)
                local land = Vector3.new(p.X + v.X * t, groundY, p.Z + v.Z * t)
                -- Sanity gate: a clamped solve on a fast/flung ball can predict
                -- a landing spot half the map away. If the prediction is wild or
                -- off the court, chase the ball's own XZ instead.
                if (Vector3.new(land.X, 0, land.Z) - Vector3.new(p.X, 0, p.Z)).Magnitude > 25
                    or not inCourt(land) then
                    land = Vector3.new(p.X, groundY, p.Z)
                end
                local myD = (ball.Position - myPos).Magnitude
                local flatD = (Vector3.new(land.X, myPos.Y, land.Z) - myPos).Magnitude
                local hum = root and root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
                -- Jump when the ball is coming down into reach.
                if hum and ballVel.Y < 0 and myD <= 9 and p.Y > myPos.Y + 3 then
                    pcall(function() hum.Jump = true end)
                end
                if flatD > 2.5 then
                    S.recState = string.format("rebound: to landing spot (%.0f)", flatD)
                    moveTowards(Vector3.new(land.X, myPos.Y, land.Z), 1)
                else
                    S.recState = "rebound: under the ball, jumping"
                    moveTowards(Vector3.new(ball.Position.X, myPos.Y, ball.Position.Z), 1)
                    if hum and ballVel.Y < 0 and myD <= 11 then
                        pcall(function() hum.Jump = true end)
                    end
                end
                return
            end
            if not S.recRebound then
                local goal = goalPosition()
                if goal then
                    local dir = ball.Position - goal
                    dir = Vector3.new(dir.X, 0, dir.Z)
                    local box = goal
                    if dir.Magnitude > 0.01 then box = goal + dir.Unit * 7 end
                    S.recState = "boxing out (chase off)"
                    moveTowards(Vector3.new(box.X, myPos.Y, box.Z), 0.9)
                    return
                end
            else
                -- grounded loose ball: only the closest teammate commits
                local myD = (ball.Position - myPos).Magnitude
                local closestMateD = math.huge
                for _, m in ipairs(mates) do
                    local md = (ball.Position - m.pos).Magnitude
                    if md < closestMateD then closestMateD = md end
                end
                if myD <= closestMateD + 1.0 then
                    S.recState = "chasing loose ball"
                    moveTowards(ball.Position, 1)
                    return
                end
                local goal = goalPosition()
                if goal then
                    local dir = ball.Position - goal
                    dir = Vector3.new(dir.X, 0, dir.Z)
                    local box = goal
                    if dir.Magnitude > 0.01 then box = goal + dir.Unit * 7 end
                    S.recState = "boxing out"
                    moveTowards(Vector3.new(box.X, myPos.Y, box.Z), 0.9)
                    return
                end
            end
        end
    end

    -- -- UNKNOWN / DEAD BALL -> hold safe spot ---------------------------------
    if not S.recOpenSpotTarget then
        S.recOpenSpotTarget = recBestOpenSpot(myPos, opps, mates, nil)
    end
    local sp = S.recOpenSpotTarget
    local d = (sp - myPos).Magnitude
    S.recState = "waiting (open spot)"
    if d > 8 then moveTowards(sp, 0.7) else stopMoving() end
end

