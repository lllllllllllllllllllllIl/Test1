-- ============================================================================

local function cleanup()
    if S.cleaned then return end
    S.cleaned = true
    pcall(function() RunService:UnbindFromRenderStep("PB_Frame") end)
    for _, c in ipairs(S.conns) do pcall(function() c:Disconnect() end) end
    S.conns = {}
    S.recFarm = false
    S.autoTime = false
    S.autoShoot = false
    S.autoGuard = false
    S.autoSteal = false
    S.autoContest = false
    S.offenseGuard = false
    S.warmupActive = false
    S.recWarmUp = false
    S.recWarmSpot = nil
    S.recWarmHold = false
    S.recWarmEngaged = false
    S.recState = "idle"
    S.smartFarm = false
    S.smartState = "IDLE"
    S.smartDefTarget = nil
    S.smartOffSpot = nil
    S.walkBoost = false
    S.autoClutch = false
    S.autoBlowBy = false
    S.walkSpeedMult = false
    S.speedWithBall = false
    S.cfSpeed = false
    S.autoSprint = false
    S.hipHeight = false
    S.ankleBreaker = false
    S.infiniteStamina = false
    S.recCdOn = false
    S.recPassPending = 0
    S.recPassTries = 0
    S.recPassTarget = nil
    S.guardApproaching = false
    moveOverride = nil
    pcall(unbindDribbleMacros)
    if Controls and origGetMoveVector then
        pcall(function() rawset(Controls, "GetMoveVector", origGetMoveVector) end)
    end
    if hooked and origNamecall then
        pcall(function() hookmetamethod(game, "__namecall", origNamecall) end)
    end
    pcall(function()
        local pkt = myPkt()
        if pkt then
            setAttr(pkt, "HoldingG", false)
            setAttr(pkt, "Sprinting", false)
        end
    end)
    -- drop the native key too, or G stays held in the game after unload
    pcall(function() if keyrelease then keyrelease(VK_G) end end)
    S.guardPressed = false
    send(InputS, "Sprint", false)
    send(InputS, "HoldG", { HoldingG = false })
    gg.PB_Cleanup = nil
end

