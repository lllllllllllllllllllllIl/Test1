-- Real keyboard input. The guard stance is driven by the local input component
-- (IsActionDown("PostGuard")), not only by the HoldG remote, which is why the
-- stance never showed for anyone else when we only fired the remote.
VK_G = 71

function gameActive()
    local ok, v = pcall(function()
        if isrbxactive then return isrbxactive() end
        if isgameactive then return isgameactive() end
        return true
    end)
    if ok then return v ~= false end
    return false
end

function nativeGuard(on)
    if on then
        if not gameActive() then return false end
        return (pcall(function() keypress(VK_G) end))
    end
    return (pcall(function() keyrelease(VK_G) end))
end

function setGuard(on)
    if S.guardState == on then return end
    S.guardState = on
    if on then
        -- native keydown first, remote second: the key event is what the local
        -- input component and the other clients actually see
        S.guardPressed = S.guardNative and nativeGuard(true) or false
        S.guardLastPress = os.clock()
        send(InputS, "HoldG", { HoldingG = true })
    else
        if S.guardPressed then nativeGuard(false) end
        S.guardPressed = false
        S.guardLastPress = 0
        send(InputS, "HoldG", { HoldingG = false })
    end
end

-- HoldingG is what flips movementType to "Guard" in the Animations controller
-- and drives the Visual stance. It is read from the packet mirror, not the
-- model, so both are written every frame while the toggle is on.
function guardTick(pkt)
    if not pkt then return end
    -- never hold the stance with the ball in hand or mid-shot
    local want = S.autoGuard and not S.shotArmed and not pktHasBall(pkt)
    if want then
        setGuard(true)
        local now = os.clock()
        -- if the native press failed (window unfocused) keep retrying it, and
        -- re-assert the remote every couple of seconds either way
        if now - (S.guardRefire or 0) > 2.0 then
            S.guardRefire = now
            if S.guardNative and not S.guardPressed then
                S.guardPressed = nativeGuard(true)
            end
            send(InputS, "HoldG", { HoldingG = true })
        end
        setAttr(pkt, "HoldingG", true)
    elseif S.guardState then
        setGuard(false)
        setAttr(pkt, "HoldingG", false)
    end
end

function sprintTick(pkt)
    if not pkt then return end
    if S.autoSprint then
        if not S.sprintOn then
            S.sprintOn = true
            send(InputS, "Sprint", true)
        end
        if not S.stamMax then
            local m = pkt.model
            local mx = m and m:GetAttribute("MaxStamina")
            S.stamMax = type(mx) == "number" and mx or 100
        end
        setAttr(pkt, "Sprinting", true)
        setAttr(pkt, "Stamina", S.stamMax)
    elseif S.sprintOn then
        S.sprintOn = false
        send(InputS, "Sprint", false)
        setAttr(pkt, "Sprinting", false)
    end
end

-- Ball Magnet: touch the ball, never walk to it.
-- firetouchinterest fires the Touched event regardless of distance in this
-- build, so the old "must be within 9 studs" gate was the reason it looked
-- dead. It now grabs the live ball from anywhere, and optionally drags it in
-- when the client owns it.
function magBall()
    local bs = WS:FindFirstChild("Basketballs")
    if not bs then return nil end
    local root = myRoot()
    if not root then return nil end
    local best, bestD = nil, math.huge
    for _, b in ipairs(bs:GetDescendants()) do
        if b:IsA("BasePart") and b.Name:lower():find("ball") then
            local d = (b.Position - root.Position).Magnitude
            if d < bestD then best, bestD = b, d end
        end
    end
    return best, bestD
end

function magnetTick(root)
    if not root then return end
    local now = os.clock()
    if now - (S.magTick or 0) < 0.03 then return end
    S.magTick = now
    local ball, d = magBall()
    if not ball then
        S.magTouches = 0
        return
    end
    local inRange = S.ballMagAnyDist or d <= (S.ballMagRange or 9)
    if inRange then
        if typeof(firetouchinterest) == "function" then
            pcall(firetouchinterest, root, ball, 0)
            pcall(firetouchinterest, root, ball, 1)
        end
        -- the pickup prompt some rack builds gate the ball behind
        if typeof(fireproximityprompt) == "function" then
            local n = 0
            for _, pr in ipairs(ball:GetDescendants()) do
                if pr:IsA("ProximityPrompt") and pr.Enabled then
                    pcall(fireproximityprompt, pr)
                    n += 1
                    if n >= 2 then break end
                end
            end
        end
        S.magTouches = 1
    else
        S.magTouches = 0
    end
    -- Optional drag: only touches a ball the client already simulates.
    if S.ballMagPull and d > 2 and d <= (S.ballMagRange or 9) * 4 then
        local netOwner = nil
        pcall(function() netOwner = ball:GetNetworkOwner() end)
        if netOwner == me and not ball.Anchored then
            pcall(function()
                local target = root.Position + root.CFrame.LookVector * 2 + Vector3.new(0, 1, 0)
                ball.CFrame = CFrame.new(target)
                ball.AssemblyLinearVelocity = Vector3.zero
            end)
        end
    end
end

-- ============================================================================
-- SMART FARM  -  RH2-style offense / defense state machine
-- States:
--   IDLE                 waiting, machine off
--   OUR_TEAM_POSSESSION  we have the ball or a teammate does -> find open spot
--   MOVING_TO_OFFENSE    walking to an open shooting spot
--   FINDING_OPEN_SPOT    at spot but defender near, drift to next option
--   OPPONENT_INBOUNDING  opponents just got possession -> sprint to defend
--   TARGETING_OPPONENT   locked onto an opponent to guard
--   DEFENDING            in defensive position, tracking assignment
--   RECOVERING           lost assignment or misc reset
-- ============================================================================

-- Shooting spot tables derived from confirmed hoop geometry
-- Hoop1 (HomeTeam defends / AwayTeam attacks): (-48.7, 12.5, -23.2)
-- Hoop2 (AwayTeam defends / HomeTeam attacks): ( 64.5,  9.9, -23.2)
-- spots are ground-level (Y = character root height, not rim height)
-- X offsets are from the rim's X; Z stays near the court center line

local HOOP1_X, HOOP1_Z = -48.7, -23.2
local HOOP2_X, HOOP2_Z =  64.5, -23.2

-- -- EXACT SPOT TABLES (coordinates confirmed in-game) ----------------------
-- All spots are for a team attacking Hoop2 (Away side, +X direction).
-- Hoop2 rim = (78.0, 14.9, -23.2). Y is set to character root height (~2).
-- Mirror formula for Home team attacking Hoop1:
--   mirX = HOOP1_X - (spotX - HOOP2_X)   mirZ = HOOP1_Z + (spotZ - HOOP2_Z)

SPOTS_3PT_AWAY = {
    { name = "Top Key",      pos = Vector3.new(29.20, 2, -19.89) },
    { name = "Right Wing",   pos = Vector3.new(34.87, 2,   0.75) },
    { name = "Left Wing",    pos = Vector3.new(33.44, 2, -43.91) },
    { name = "Right Corner", pos = Vector3.new(65.54, 2,  13.06) },
    { name = "Left Corner",  pos = Vector3.new(40.92, 2, -34.49) },
}

SPOTS_2PT_AWAY = {
    { name = "Right Elbow",  pos = Vector3.new(40.92, 2, -17.00) },
    { name = "Right Key",    pos = Vector3.new(40.92, 2, -12.72) },
    { name = "Left Key",     pos = Vector3.new(40.92, 2, -34.86) },
}

-- mirror a spot-list from Away (attack Hoop2) to Home (attack Hoop1)
function mirrorSpots(list)
    local out = {}
    for _, s in ipairs(list) do
        local mx = HOOP1_X - (s.pos.X - HOOP2_X)
        local mz = HOOP1_Z + (s.pos.Z - HOOP2_Z)
        out[#out+1] = { name = s.name, pos = Vector3.new(mx, s.pos.Y, mz) }
    end
    return out
end

SPOTS_3PT_HOME = mirrorSpots(SPOTS_3PT_AWAY)
SPOTS_2PT_HOME = mirrorSpots(SPOTS_2PT_AWAY)

-- returns {list3pt, list2pt} for our team
function mySpotLists()
    local pkt = myPkt()
    local isHome = pkt and pktAttr(pkt, "HomeTeam")
    if isHome then
        return SPOTS_3PT_HOME, SPOTS_2PT_HOME
    else
        return SPOTS_3PT_AWAY, SPOTS_2PT_AWAY
    end
end

-- smart farm dropdown state
-- S.smartSpot3 = "Rotate" | spot name
-- S.smartSpot2 = "Rotate" | spot name
-- S.smartSpotMode = "3PT" | "2PT" | "Any"
-- S.smartRotIdx3, S.smartRotIdx2 = rotation indices

-- resolve the target spot entry {name,pos} for current settings
-- Forward declaration: resolveSpot() below uses this before the body is
-- reached, and the nil global broke the "Any" shot-type branch.
local spotIsContested

function resolveSpot()
    local list3, list2 = mySpotLists()
    local mode = S.smartSpotMode or "3PT"

    local function pickFrom(list, key, rotKey)
        local sel = S[key]
        if sel == "Rotate" then
            local idx = (S[rotKey] or 1)
            if idx > #list then idx = 1 end
            return list[idx]
        end
        for _, s in ipairs(list) do
            if s.name == sel then return s end
        end
        return list[1]
    end

    if mode == "3PT" then
        return pickFrom(list3, "smartSpot3", "smartRotIdx3")
    elseif mode == "2PT" then
        return pickFrom(list2, "smartSpot2", "smartRotIdx2")
    else -- "Any"  -  prefer 3PT unless contested
        local s3 = pickFrom(list3, "smartSpot3", "smartRotIdx3")
        if s3 and not spotIsContested(s3.pos, 5) then return s3 end
        return pickFrom(list2, "smartSpot2", "smartRotIdx2")
    end
end

-- advance rotation index (called when we arrive at a spot and want to cycle)
function advanceRot()
    local list3, list2 = mySpotLists()
    local mode = S.smartSpotMode or "3PT"
    if mode ~= "2PT" and S.smartSpot3 == "Rotate" then
        S.smartRotIdx3 = ((S.smartRotIdx3 or 1) % #list3) + 1
    end
    if mode ~= "3PT" and S.smartSpot2 == "Rotate" then
        S.smartRotIdx2 = ((S.smartRotIdx2 or 1) % #list2) + 1
    end
end

-- returns the spot list for our team (compat shim for old callers)
function myOffSpots()
    local list3, list2 = mySpotLists()
    local combined = {}
    for _, s in ipairs(list3) do combined[#combined+1] = s.pos end
    for _, s in ipairs(list2) do combined[#combined+1] = s.pos end
    return combined
end

-- defender too close to a spot?
function spotIsContested(pos, minDist)
    minDist = minDist or 5
    local root = myRoot()
    if not root then return false end
    for _, pkt in ipairs(allPackets()) do
        if isOpponent(pkt) then
            local r = pktRoot(pkt)
            if r and (r.Position - pos).Magnitude < minDist then
                return true
            end
        end
    end
    return false
end

-- pick the best open spot: prefer 3PT (indices 1-4), fall back to 2PT (5-6)
-- skip if any opponent is within minDist
function pickOpenSpot(spots, minDist)
    local root = myRoot()
    if not root then return spots[1] end
    -- score = dist-from-self (closer is better for 2PT, irrelevant for 3)
    -- but prefer uncontested 3 > contested 3 > open 2 > contested 2
    local best, bestScore = nil, math.huge
    for i, sp in ipairs(spots) do
        local is3 = (i <= 4)
        local contested = spotIsContested(sp, minDist or 5)
        -- priority weight: uncontested 3=0, contested 3=1000, open 2=2000, contested 2=3000
        local priority = (is3 and 0 or 2000) + (contested and 1000 or 0)
        local dist = (Vector3.new(root.Position.X, 0, root.Position.Z)
                    - Vector3.new(sp.X, 0, sp.Z)).Magnitude
        local score = priority + dist * 0.1
        if score < bestScore then best, bestScore = sp, score end
    end
    return best or spots[1]
end

-- find the teammate that has the ball, or nil
function teammateBallCarrier()
    local me = myPkt()
    for _, pkt in ipairs(allPackets()) do
        if pkt ~= me and not isOpponent(pkt) and pktHasBall(pkt) then
            return pkt
        end
    end
    return nil
end

-- pick the best opponent to guard: closest to our defending basket
function pickDefTarget()
    local me = myPkt()
    if not me then return nil end
    local isHome = pktAttr(me, "HomeTeam")
    -- our defending basket
    local defBasket = isHome
        and Vector3.new(HOOP1_X, 18.1, HOOP1_Z)
        or  Vector3.new(HOOP2_X, 14.9, HOOP2_Z)
    local best, bestDist = nil, math.huge
    for _, pkt in ipairs(allPackets()) do
        if isOpponent(pkt) then
            local r = pktRoot(pkt)
            if r then
                local d = (r.Position - defBasket).Magnitude
                if d < bestDist then best, bestDist = pkt, d end
            end
        end
    end
    return best
end

function smartFarmTick()
    if S.cleaned then return end
    local pkt = myPkt()
    local root = pktRoot(pkt)
    if not pkt or not root then S.smartState = "RECOVERING" return end

    local now = os.clock()
    local weHaveBall = pktHasBall(pkt)
    local teamHasBall = weHaveBall or (teammateBallCarrier() ~= nil)

    -- debug overlay (throttled)
    if S.smartDebug and now - S.smartDebugLast > 1.2 then
        S.smartDebugLast = now
        local tgtName = ""
        if S.smartDefTarget then
            local r = pktRoot(S.smartDefTarget)
            tgtName = r and string.format(" | def->(%.0f,%.0f)",r.Position.X,r.Position.Z) or ""
        end
        if S.smartOffSpot then
            local sp = S.smartOffSpot
            tgtName = tgtName .. string.format(" | off->(%.0f,%.0f)",sp.X,sp.Z)
        end
        notify("SmartFarm", "["..S.smartState.."]"..tgtName)
    end

    -- -- STATE MACHINE ---------------------------------------------------------

    if S.smartState == "IDLE" then
        -- shouldn't be called in IDLE, but transition out if ball situation known
        if teamHasBall then
            S.smartState = "OUR_TEAM_POSSESSION"
        else
            S.smartState = "OPPONENT_INBOUNDING"
        end

    elseif S.smartState == "OUR_TEAM_POSSESSION" then
        if not teamHasBall then
            -- lost possession
            S.smartState = "OPPONENT_INBOUNDING"
            S.smartDefTarget = nil
            return
        end
        -- resolve the target spot from dropdowns
        local spotEntry = resolveSpot()
        S.smartOffSpot = spotEntry and spotEntry.pos or myOffSpots()[1]
        S.smartState = "MOVING_TO_OFFENSE"

    elseif S.smartState == "MOVING_TO_OFFENSE" then
        if not teamHasBall then
            S.smartState = "OPPONENT_INBOUNDING"
            stopMoving()
            return
        end
        local sp = S.smartOffSpot
        if not sp then
            S.smartState = "OUR_TEAM_POSSESSION"
            return
        end
        local dist = (Vector3.new(root.Position.X, 0, root.Position.Z)
                    - Vector3.new(sp.X, 0, sp.Z)).Magnitude
        if dist < 3.5 then
            -- arrived  -  if rotating, advance index for next possession
            advanceRot()
            S.smartState = "FINDING_OPEN_SPOT"
            stopMoving()
        else
            moveTowards(Vector3.new(sp.X, root.Position.Y, sp.Z), 1)
        end

    elseif S.smartState == "FINDING_OPEN_SPOT" then
        if not teamHasBall then
            S.smartState = "OPPONENT_INBOUNDING"
            stopMoving()
            return
        end
        -- re-evaluate: if current spot contested, advance rotation and re-resolve
        local sp = S.smartOffSpot
        if not sp or spotIsContested(sp, 4) then
            advanceRot()
            local spotEntry = resolveSpot()
            local newSpot = spotEntry and spotEntry.pos
            if newSpot and newSpot ~= sp then
                S.smartOffSpot = newSpot
                S.smartState = "MOVING_TO_OFFENSE"
            end
        else
            -- open  -  hold position
            stopMoving()
        end

    elseif S.smartState == "OPPONENT_INBOUNDING" then
        if teamHasBall then
            S.smartState = "OUR_TEAM_POSSESSION"
            return
        end
        -- sprint toward our defensive basket side and pick a target
        S.smartDefTarget = pickDefTarget()
        if S.smartDefTarget then
            S.smartState = "TARGETING_OPPONENT"
        else
            -- no opponents visible, hold
            stopMoving()
        end

    elseif S.smartState == "TARGETING_OPPONENT" then
        if teamHasBall then
            S.smartState = "OUR_TEAM_POSSESSION"
            S.smartDefTarget = nil
            stopMoving()
            return
        end
        local tgt = S.smartDefTarget
        if not tgt then
            S.smartState = "RECOVERING"
            return
        end
        local tgtRoot = pktRoot(tgt)
        if not tgtRoot then
            S.smartDefTarget = nil
            S.smartState = "RECOVERING"
            return
        end
        -- run toward assignment
        local dist = (tgtRoot.Position - root.Position).Magnitude
        if dist < 18 then
            S.smartState = "DEFENDING"
        else
            moveTowards(Vector3.new(tgtRoot.Position.X, root.Position.Y, tgtRoot.Position.Z), 1)
        end

    elseif S.smartState == "DEFENDING" then
        if teamHasBall then
            S.smartState = "OUR_TEAM_POSSESSION"
            S.smartDefTarget = nil
            stopMoving()
            return
        end
        local tgt = S.smartDefTarget
        if not tgt then S.smartState = "RECOVERING" return end
        local tgtRoot = pktRoot(tgt)
        if not tgtRoot then
            S.smartDefTarget = nil
            S.smartState = "RECOVERING"
            return
        end

        -- switch target occasionally if someone closer has the ball
        if now - S.smartLastSwitch > 2.0 then
            local ballCarrier, bcd = nearestOpponent(30, true)
            if ballCarrier and ballCarrier ~= tgt and bcd < 20 then
                S.smartLastSwitch = now
                S.smartDefTarget = ballCarrier
                tgt = ballCarrier
                tgtRoot = pktRoot(tgt)
                if not tgtRoot then S.smartState = "RECOVERING" return end
            end
        end

        -- position between assignment and our basket (same logic as autoGuard fix)
        local me2 = myPkt()
        local isHome2 = me2 and pktAttr(me2, "HomeTeam")
        local defBasket2 = isHome2
            and Vector3.new(HOOP1_X, 18.1, HOOP1_Z)
            or  Vector3.new(HOOP2_X, 14.9, HOOP2_Z)
        local toBasket2 = defBasket2 - tgtRoot.Position
        toBasket2 = Vector3.new(toBasket2.X, 0, toBasket2.Z)
        if toBasket2.Magnitude > 0.01 then
            local defTarget = tgtRoot.Position + toBasket2.Unit * 1.5
            moveTowards(Vector3.new(defTarget.X, root.Position.Y, defTarget.Z), 0.85)
        end

        -- if assignment wandered far, follow
        local dist2 = (tgtRoot.Position - root.Position).Magnitude
        if dist2 > 30 then
            S.smartState = "TARGETING_OPPONENT"
        end

    elseif S.smartState == "RECOVERING" then
        stopMoving()
        -- re-enter based on ball
        if teamHasBall then
            S.smartState = "OUR_TEAM_POSSESSION"
        elseif now - S.smartLastSwitch > 1.0 then
            S.smartLastSwitch = now
            S.smartState = "OPPONENT_INBOUNDING"
        end
    end
end

-- ============================================================================
-- HEARTBEAT MIRROR
-- The game's controllers read attributes on RenderStepped. Writing on
-- Heartbeat guarantees our value is already in place when they read it, so a
-- replication tick cannot stomp HoldingG / Sprinting between frames.
-- ============================================================================

track(RunService.Heartbeat:Connect(function()
    if S.cleaned then return end
    local pkt = myPkt()
    if not pkt then return end
    pcall(guardTick, pkt)
    pcall(sprintTick, pkt)
end))

-- ============================================================================
-- MAIN LOOP
-- ============================================================================

function frameStep()
    if S.cleaned then return end

    local pkt = myPkt()
    local root = pktRoot(pkt)
    local held = pktHasBall(pkt)

    -- AUTO TIME --------------------------------------------------------------
    if S.shotArmed and S.autoTime then
        if S.releaseAtFull then
            -- Release At Full: use live bar fill and predict its target using ping.
            local fill = meterFillNow()
            if fill then
                local target = math.clamp(S.greenTarget or 99, 1, 100) / 100
                local turned = false
                if S.meterAxis == "Y" and S.axRawVal then
                    -- Y sweep: lowest/highest raw values since arming. Fill is the
                    -- distance from the highest point, so the arm-time rest value
                    -- does not matter. Y bars reverse near -0.95.
                    local v, now = S.axRawVal, os.clock()
                    if not S.axMin or v < S.axMin then S.axMin, S.axMinT = v, now end
                    if not S.axMax or v > S.axMax then S.axMax, S.axMaxT = v, now end
                    -- Each meter has its own swing span. Key it by resting value and
                    -- learn the span from the first observed turn.
                    S.spanByRest = S.spanByRest or {}
                    local restKey = S.shotBaseOff and string.format("%.1f", S.shotBaseOff.Y) or "?"
                    if S.axMax - S.axMin >= 0.5 then
                        if S.axMinT > S.axMaxT and v > S.axMin + 0.03 then turned = true end
                        if S.axMaxT > S.axMinT and v < S.axMax - 0.03 then turned = true end
                        if turned then S.spanByRest[restKey] = S.axMax - S.axMin end
                    end
                    -- distance travelled from whichever end the bar is leaving
                    fill = math.clamp(math.max(S.axMax - v, v - S.axMin), 0, 1)
                    local known = S.spanByRest[restKey]
                    target = S.targetFrac[restKey] or (known and math.clamp(known * 0.95, 0.05, 1)) or 0.95
                    S.lastRestKey, S.lastYFrame = restKey, os.clock()
                end
                S.fullPeak = math.max(S.fullPeak or 0, fill)
                -- Predicted arrival (ping-compensated) fires first, so the release
                -- goes out before the bar reverses. The turn check is the fallback.
                if fillReachedTarget(fill, target) then
                    doRelease("full")
                elseif turned or (S.fullPeak >= 0.5 and fill < S.fullPeak - 0.03) then
                    doRelease("peak")
                end
            end
        elseif not (S.autoTimeMeterSync and meterReleasePoint()) then
            if os.clock() - S.shotT0 >= releaseDelay() then doRelease("timer") end
        end
    end

    -- GUARD -----------------------------------------------------------------
    guardTick(pkt)

    -- PASS WATCHDOG ---------------------------------------------------------
    -- retries a dropped pass so a covered/inbound possession never stalls
    recPassWatch(pkt)

    -- BALL MAGNET -----------------------------------------------------------
    if S.ballMag and root and not held then pcall(magnetTick, root) end

    local movementClaimed = false

    -- REC -------------------------------------------------------------------
    if S.recFarm then movementClaimed = true; recFarmTick() end

    -- AUTO GUARD / STEAL ----------------------------------------------------
    if not movementClaimed and (S.autoGuard or S.autoSteal) and root then
        local carrier, cd = nearestOpponent(S.guardRange + 20, true)
        if carrier and cd then
            local oroot = pktRoot(carrier)
            if oroot then
                if S.autoGuard then
                    -- fixed standoff between us and our defending basket; the
                    -- shared helper stops the moment we are on the anchor, which
                    -- is what kills the drift the old chase-forever code had
                    guardMove(oroot, cd)
                    movementClaimed = true
                end
                if S.autoSteal and cd < S.guardRange and os.clock() - S.lastSteal > 0.45 then
                    S.lastSteal = os.clock()
                    S.statSteals = (S.statSteals or 0) + 1
                    send(InputS, "Steal")
                end
            end
        elseif S.autoGuard then
            -- nobody has the ball in range: drop the stance and stop rather
            -- than sliding on a stale move vector
            S.guardApproaching = false
            if S.guardState then setGuard(false) end
            stopMoving()
        end
    end

    -- AUTO CONTEST ----------------------------------------------------------
    if S.autoContest and root then
        local shooter, sd = nearestOpponent(9, true)
        local act = shooter and pktAttr(shooter, "Action") or ""
        S.contestAction = tostring(act)
        if shooter and sd and (act == "Shooting" or act == "Dunking" or act == "Gathering" or act == "CatchingPass") then
            if not movementClaimed then moveTowards(pktRoot(shooter).Position, 1) end
            if os.clock() - S.lastJump > 0.8 then
                S.lastJump = os.clock()
                send(InputS, "Jump")
            end
        end
    end

    -- AUTO SHOOT (uses Auto Time) -------------------------------------------
    if not movementClaimed and S.autoShoot and held and not S.shotArmed then
        local _, dist = nearestOpponent(150, false)
        -- range gate first: never hoist from outside the rim distance
        local canShoot = shotAllowed()
        if canShoot and (dist or 999) >= S.shootOpenRange
            and os.clock() - S.lastRelease > 1.0 then
            stopMoving()
            shootNow()
        end
    end

    -- OFFENSE GUARD ---------------------------------------------------------
    if S.offenseGuard and root and not held then
        local carrier, cd2 = nearestOpponent(100, true)
        if carrier then
            local oroot2 = pktRoot(carrier)
            if oroot2 and os.clock() - S.lastOffGuard > 0.08 then
                S.lastOffGuard = os.clock()
                moveTowards(oroot2.Position, 1)
                movementClaimed = true
            end
        end
    end

    -- SMART FARM (RH2-style offense / defense) ---------------------------------
    if S.smartFarm and not movementClaimed then
        pcall(smartFarmTick)
        movementClaimed = true
    end

    -- ANIMATION OVERRIDE (continuous write) --------------------------------
    if (S.animJumpShot ~= "None" or S.animDunk ~= "None") then
        pcall(applyAnimOverride)
    end

    -- WALK SPEED MULTIPLIER -------------------------------------------------
    -- AUTO CLUTCH -----------------------------------------------------------
    -- Fires only while a dunk is actually running. The packet the server is
    -- already processing reports Action = "Dunking" for the whole gather ->
    -- rim window, so that single check is the whole gate: no radius, no rim
    -- distance, no defender scan. If the dunk is live, Clutch goes out.
    -- Clutch:FireServer takes one boolean -- matches the game's own call.
    if S.autoClutch and ClutchR then
        pcall(function()
            if pktAttr(pkt, "Action") ~= "Dunking" then return end
            local nowAC = os.clock()
            if nowAC - (S.lastClutchAt or 0) < 0.5 then return end
            S.lastClutchAt = nowAC
            ClutchR:FireServer(true)   -- boolean arg, verified by decompile
        end)
    end

    -- AUTO BLOW BY: burst past defender standing in front --------------------
    if S.autoBlowBy and held and not movementClaimed then
        local now_bb = os.clock()
        if now_bb - S.blowByLast > 1.2 then
            pcall(function()
                local pktBB = myPkt()
                local rootBB = pktRoot(pktBB)
                if rootBB then
                    local facingDir = rootBB.CFrame.LookVector
                    -- scan for a defender directly in front within 4 studs
                    local packets = allPackets()
                    for _, op in ipairs(packets) do
                        if isOpponent(op) then
                            local or2 = pktRoot(op)
                            if or2 then
                                local toOpp = (or2.Position - rootBB.Position)
                                local dist = toOpp.Magnitude
                                if dist < 4 then
                                    local dot = facingDir:Dot(toOpp.Unit)
                                    if dot > 0.5 then  -- defender is within 60 deg in front
                                        S.blowByLast = now_bb
                                        -- fire dribble burst: sprint + directional dribble input
                                        send(InputS, "Sprint", { Sprinting = true })
                                        send(InputS, "MoveDirection", { X = facingDir.X, Y = 0, Z = facingDir.Z })
                                        playDribble("Crossover")
                                        movementClaimed = true
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end

    -- AUTO ANKLE BREAKER: fire SnatchBack or Cross when defender reaches in ---
    if S.ankleBreaker and held then
        local now_ab = os.clock()
        if now_ab - S.ankleLastFire > 0.8 then
            pcall(function()
                local pktAB = myPkt()
                local rootAB = pktRoot(pktAB)
                if rootAB then
                    for _, op in ipairs(allPackets()) do
                        if isOpponent(op) then
                            local rop = pktRoot(op)
                            if rop then
                                local dist = (rop.Position - rootAB.Position).Magnitude
                                local act = pktAttr(op, "Action") or ""
                                local reaching = act:lower():find("steal") or act:lower():find("reach") or act:lower():find("defend")
                                if dist < 3.5 or (dist < 5.5 and reaching) then
                                    S.ankleLastFire = now_ab
                                    playDribble(S.anklebreakerMove)
                                    break
                                end
                            end
                        end
                    end
                end
            end)
        end
    end

    -- INFINITE STAMINA: keep stamina maxed every frame -----------------------
    if S.infiniteStamina then
        pcall(function()
            local pktIS = myPkt()
            if pktIS then
                if not S.stamMax then
                    local mx = pktIS.model and pktIS.model:GetAttribute("MaxStamina")
                    S.stamMax = type(mx) == "number" and mx or 100
                end
                setAttr(pktIS, "Stamina", S.stamMax)
            end
        end)
    end

    -- AUTO SPRINT -----------------------------------------------------------
    sprintTick(pkt)

    -- HIP HEIGHT reset ------------------------------------------------------
    if not S.hipHeight then S.hipBaseY = nil end

    -- SPOOFERS --------------------------------------------------------------
    if S.spoofCoins or S.spoofRank or S.spoofOverall or S.spoofName then
        applySpoofs()
    end
end

pcall(function() RunService:UnbindFromRenderStep("PB_Frame") end)
RunService:BindToRenderStep("PB_Frame", Enum.RenderPriority.Character.Value + 1, frameStep)

