-- RunGreenEffect fires inbound from the server when a basket is scored with
-- a green effect. Args: (characterModel, ball, goal, serverTime, effectName)
-- The game only fires it to clients the server believes own the effect, so
-- we intercept it here and play it ourselves using our equipped effect.
track(listen(RunGreenR, function(charModel, ball, goal, serverTime, effectName)
    if not S.greenFxAuto then return end
    local mod = greenFxModule()
    if not mod or type(mod.RunEffect) ~= "function" then return end
    -- use our chosen effect name if set, otherwise fall back to what the server sent
    local name = (type(S.greenFx) == "string" and S.greenFx ~= "") and S.greenFx
        or (type(effectName) == "string" and effectName)
        or "Basic"
    local pkt = myPkt()
    if not pkt or not pkt.model then return end
    local useBall = (typeof(ball) == "Instance" and ball) or looseBall(18) or pktRoot(pkt)
    local useGoal = (typeof(goal) == "Instance" and goal) or myGoal() or pktRoot(pkt)
    if not useBall or not useGoal then return end
    pcall(function()
        mod:RunEffect(pkt.model, useBall, useGoal, serverTime or WS:GetServerTimeNow(), name)
    end)
end))

