local function bestPassTarget()
    local root = myRoot()
    if not root then return nil end
    local best, bestScore = nil, -1
    local meP = myPkt()
    for _, pkt in ipairs(allPackets()) do
        if pkt ~= meP and not isOpponent(pkt) then
            local r = pktRoot(pkt)
            if r then
                local d = (r.Position - root.Position).Magnitude
                if d > 3 and d < 45 then
                    local open = 1
                    for _, op in ipairs(allPackets()) do
                        if isOpponent(op) then
                            local oroot = pktRoot(op)
                            if oroot and (oroot.Position - r.Position).Magnitude < 6 then
                                open = 0
                                break
                            end
                        end
                    end
                    local score = open * 100 - d
                    if score > bestScore then best, bestScore = pkt, score end
                end
            end
        end
    end
    return best
end

local function recTryPass(reason, ptype)
    local pkt = myPkt()
    if not pkt or not pktHasBall(pkt) then return false end
    local target = bestPassTarget()
    if not target then return false end
    S.recPassTarget = pktName(target)
    S.recPassType = ptype or 1
    S.recPassPending = os.clock()
    S.recPassTries = (S.recPassTries or 0) + 1
    send(InputS, "Pass", { Target = S.recPassTarget, Type = S.recPassType })
    pcall(function() send(InputS, "Pass", S.recPassTarget) end)
    S.statPasses = (S.statPasses or 0) + 1
    return true
end

