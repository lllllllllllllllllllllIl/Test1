-- JoinPlace takes a Places enum KEY, not a numeric id. The game's own UI calls
-- JoinPlace("Plaza") / ("Park") / ("Main"); the server resolves the key through
-- Shared.Config.Enum.Places. The old code sent 104645279125178 and the server
-- had nothing to resolve, which is why the teleport buttons did nothing.
local function joinPlaceKey(key, fallbackId)
    local r = rawRemote("TeleportService", "JoinPlace")
        or rawRemote("InterfaceService", "JoinPlace")
        or JoinPlaceR
    if not r then notify("REC", "JoinPlace remote missing") return false end
    task.spawn(function()
        local ok = pcall(function() return r:InvokeServer(key) end)
        if not ok and fallbackId then
            pcall(function() return r:InvokeServer(fallbackId) end)
        end
    end)
    return true
end

local function joinRec()
    joinPlaceKey("Rec", S.recPlaceId)
    notify("REC", "joining Recreational Center...")
end

local function joinRecQueue()
    joinPlaceKey("RecQueue", S.recQueuePlaceId)
    notify("REC", "joining REC queue...")
end

-- Ready is a different remote in every place:
--   REC social hub  -> CourtService.Captain      (bare RemoteEvent)
--   REC queue       -> QueueService.Ready(bool)  (RemoteFunction, true = ready)
--   blacktop queue  -> MatchmakingService.ReadyUp
-- The queue UI's Ready button is what enforces the cooldown: it reads
-- Player:GetAttribute("RecLockedUntil"), compares it to GetServerTimeNow and
-- returns BEFORE calling the remote. Calling the remote directly skips that
-- check entirely, which is the whole bypass.
local READY_TARGETS = {
    { service = "CourtService",       remote = "Captain",  kind = "event" },
    { service = "QueueService",       remote = "Ready",    kind = "function", arg = true },
    { service = "MatchmakingService", remote = "ReadyUp",  kind = "function" },
}

function readyTarget()
    for _, c in ipairs(READY_TARGETS) do
        local r = rawRemote(c.service, c.remote)
        if r then return r, c end
    end
    return nil, nil
end

function recFireReady()
    local r, c = readyTarget()
    if not r then S.recReadyLabel = "no ready remote" return false end
    S.recReadyLabel = c.service .. "." .. c.remote
    if c.kind == "event" then
        local ok = pcall(function() r:FireServer() end)
        if ok then S.recCdCount = (S.recCdCount or 0) + 1 end
        return ok
    end
    -- RemoteFunctions yield, so never invoke on the caller's thread: the
    -- bypass loop runs at 20 Hz and a blocking invoke would stall it.
    task.spawn(function()
        local ok = pcall(function() return r:InvokeServer(c.arg) end)
        if ok then S.recCdCount = (S.recCdCount or 0) + 1 end
    end)
    return true
end

-- Seconds left on the REC lockout the queue UI enforces client-side.
function recLockSeconds()
    local ok, v = pcall(function() return me:GetAttribute("RecLockedUntil") end)
    if not ok or type(v) ~= "number" or v <= 0 then return 0 end
    local ok2, now = pcall(function() return workspace:GetServerTimeNow() end)
    if not ok2 or type(now) ~= "number" then return 0 end
    local d = v - now
    return d > 0 and d or 0
end

function autoReady()
    if recFireReady() then
        local lock = recLockSeconds()
        if lock > 0 then
            notify("REC", "ready sent, bypassing " .. math.ceil(lock) .. "s lockout")
        else
            notify("REC", "ready sent (" .. tostring(S.recReadyLabel) .. ")")
        end
        return
    end
    notify("REC", "no ready remote in this place")
end

-- Cooldown bypass. The Ready gate lives in the queue UI's button handler, not
-- on the server: it bails on RecLockedUntil before the remote is ever called.
-- Firing the remote on a short interval walks straight through the lockout.
function recCooldownTick()
    if S.cleaned or not S.recCdOn then return end
    local now = os.clock()
    if now < (S.recCdNext or 0) then return end
    S.recCdNext = now + math.max(0.1, S.recCdInterval or 0.35)
    local pid = game.PlaceId
    local gm = nil
    pcall(function() gm = workspace:GetAttribute("Gamemode") end)
    local okPlace = (pid == S.recPlaceId) or (pid == S.recQueuePlaceId)
        or gm == "RecQueue" or gm == "BlacktopMatchmaking"
    if not okPlace then return end
    local pkt = myPkt()
    if pkt and pktAttr(pkt, "InGame") == true then return end
    recFireReady()
end

task.spawn(function()
    while not S.cleaned do
        pcall(recCooldownTick)
        task.wait(0.05)
    end
end)

-- Party invite. The REC hub's Parties UI fires `PartyService.partyInvitation`
-- with the target's NAME (not a UserId), so that is the shape here. The queue
-- place ships no party invite remote at all - its PartyService only exposes
-- getParty - so fall back to matchmaking AddPlayerToTeam, which is the only
-- "bring people in" call that place actually has.
INVITE_NAMES = { "partyInvitation", "invite", "invitePlayer", "sendInvite", "partyInvite" }

function inviteRemote()
    local ps = Svc and Svc:FindFirstChild("PartyService")
    if not ps then return nil end
    for _, n in ipairs(INVITE_NAMES) do
        local c = ps:FindFirstChild(n)
        if c and (c:IsA("RemoteEvent") or c:IsA("RemoteFunction")) then return c end
    end
    return nil
end

function inviteAllToRec()
    local r = inviteRemote()
    if r then
        local sent = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= me then
                local ok
                if r:IsA("RemoteFunction") then
                    ok = pcall(function() return r:InvokeServer(p.Name) end)
                else
                    ok = pcall(function() r:FireServer(p.Name) end)
                end
                if ok then sent = sent + 1 end
            end
        end
        notify("REC", "invited " .. sent .. " via " .. r.Name)
        return
    end
    local mm = rawRemote("MatchmakingService", "AddPlayerToTeam")
    if not mm then
        notify("REC", "no invite remote in this place - use it from the REC hub")
        return
    end
    task.spawn(function()
        local added = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= me then
                local ok, res = pcall(function() return mm:InvokeServer(p.Name) end)
                if ok and res then added = added + 1 end
            end
        end
        notify("REC", "lobby add: " .. added .. " accepted")
    end)
end

