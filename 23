--========================================================--
--  AUTO PERFECT LOGIC
--========================================================--
local function setupAutoPerfect()
    local char = getChar()
    if not char then return end

    char:GetAttributeChangedSignal("meterOffset"):Connect(function()
        if not Toggles.AutoPerfect.Value then return end

        local offset = char:GetAttribute("meterOffset")
        if not offset then return end

        local trigger = Options.MeterOffset.Value

        if char.HumanoidRootPart:FindFirstChild("VerticalMeter") and char.HumanoidRootPart.VerticalMeter.Enabled then
            if offset.Y <= trigger then
                RS.Aero.AeroRemoteServices.InputService.Shoot:FireServer({Shoot = false})
            end
        elseif char.HumanoidRootPart:FindFirstChild("BatMeter") and char.HumanoidRootPart.BatMeter.Enabled then
            if offset.Y <= trigger then
                RS.Aero.AeroRemoteServices.InputService.Shoot:FireServer({Shoot = false})
            end
        elseif char.HumanoidRootPart:FindFirstChild("RocketMeter") and char.HumanoidRootPart.RocketMeter.Enabled then
            if offset.Y <= trigger then
                RS.Aero.AeroRemoteServices.InputService.Shoot:FireServer({Shoot = false})
            end
        elseif char.Head:FindFirstChild("HoopMeter") and char.Head.HoopMeter.Enabled then
            if offset.Y >= trigger then
                RS.Aero.AeroRemoteServices.InputService.Shoot:FireServer({Shoot = false})
            end
        elseif char.Head:FindFirstChild("RobloxMeter") and char.Head.RobloxMeter.Enabled then
            if offset.X >= trigger then
                RS.Aero.AeroRemoteServices.InputService.Shoot:FireServer({Shoot = false})
            end
        else
            if offset.Y <= trigger then
                RS.Aero.AeroRemoteServices.InputService.Shoot:FireServer({Shoot = false})
            end
        end
    end)
end

setupAutoPerfect()

player.CharacterAdded:Connect(function()
    task.wait(1)
    setupAutoPerfect()
end)

