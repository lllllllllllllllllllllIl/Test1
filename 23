-- Auto Perfect Logic
local function setupAutoPerfect()
    local char = getChar()
    if not char then return end

    local connection
    connection = char:GetAttributeChangedSignal("meterOffset"):Connect(function()
        if not Toggles.AutoPerfect or not Toggles.AutoPerfect.Value then return end

        local offset = char:GetAttribute("meterOffset")
        if not offset then return end

        local trigger = Options.MeterOffset and Options.MeterOffset.Value or -1.239
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")

        local function shoot()
            pcall(function()
                RS.Aero.AeroRemoteServices.InputService.Shoot:FireServer({Shoot = false})
            end)
        end

        if hrp then
            if hrp:FindFirstChild("VerticalMeter") and hrp.VerticalMeter.Enabled and offset.Y <= trigger then
                shoot()
            elseif hrp:FindFirstChild("BatMeter") and hrp.BatMeter.Enabled and offset.Y <= trigger then
                shoot()
            elseif hrp:FindFirstChild("RocketMeter") and hrp.RocketMeter.Enabled and offset.Y <= trigger then
                shoot()
            end
        end

        if head then
            if head:FindFirstChild("HoopMeter") and head.HoopMeter.Enabled and offset.Y >= trigger then
                shoot()
            elseif head:FindFirstChild("RobloxMeter") and head.RobloxMeter.Enabled and offset.X >= trigger then
                shoot()
            end
        end
    end)
end

task.spawn(function()
    setupAutoPerfect()
    player.CharacterAdded:Connect(function()
        task.wait(1.5)
        setupAutoPerfect()
    end)
end)

