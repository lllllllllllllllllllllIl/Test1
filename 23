local function getChar()
    local chars = WS:FindFirstChild("Characters")
    return chars and chars:FindFirstChild(me.Name)
end

local function myPkt()
    if CharsCtrl and CharsCtrl.GetPacket then
        local ok, p = pcall(function() return CharsCtrl:GetPacket(me) end)
        if ok and p then return p end
    end
    if CharsCtrl and type(CharsCtrl.Packets) == "table" then
        return CharsCtrl.Packets[me.UserId] or CharsCtrl.Packets[me.Name]
    end
    return nil
end

local function pktAttr(pkt, key)
    if not pkt then return nil end
    if pkt.attributes then return pkt.attributes[key] end
    local m = pkt.model
    if m then
        local ok, v = pcall(function() return m:GetAttribute(key) end)
        if ok then return v end
    end
    return nil
end

local function setAttr(pkt, key, val)
    if not pkt then return end
    if pkt.attributes then pkt.attributes[key] = val end
    local m = pkt.model
    if m then pcall(function() m:SetAttribute(key, val) end) end
end

local function pktRoot(pkt)
    if not pkt then return nil end
    local m = pkt.model or pkt.Character
    if m then
        return m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
    end
    return nil
end

local function myRoot()
    local pkt = myPkt()
    local r = pktRoot(pkt)
    if r then return r end
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function pktHasBall(pkt)
    if not pkt then return false end
    local v = pktAttr(pkt, "HasBall")
    if v ~= nil then return v == true end
    v = pktAttr(pkt, "Ball")
    return v ~= nil and v ~= false
end

local function hasBall()
    return pktHasBall(myPkt())
end

local function allPackets()
    local out = {}
    if CharsCtrl and type(CharsCtrl.Packets) == "table" then
        for _, p in pairs(CharsCtrl.Packets) do out[#out + 1] = p end
        return out
    end
    return out
end

local function isOpponent(pkt)
    if not pkt then return false end
    local meP = myPkt()
    if not meP then return false end
    local myHome = pktAttr(meP, "HomeTeam")
    local theirHome = pktAttr(pkt, "HomeTeam")
    if myHome == nil or theirHome == nil then return false end
    return myHome ~= theirHome
end

local function pktName(pkt)
    if not pkt then return "?" end
    if pkt.player then return pkt.player.Name end
    if pkt.model then return pkt.model.Name end
    return "?"
end

local function nearestOpponent(range, needBall)
    local root = myRoot()
    if not root then return nil, nil end
    local best, bestD = nil, range or 150
    for _, pkt in ipairs(allPackets()) do
        if isOpponent(pkt) then
            if needBall and not pktHasBall(pkt) then continue end
            local r = pktRoot(pkt)
            if r then
                local d = (r.Position - root.Position).Magnitude
                if d < bestD then best, bestD = pkt, d end
            end
        end
    end
    return best, bestD
end

local function goalPosition()
    local pkt = myPkt()
    if not pkt then return nil end
    local isHome = pktAttr(pkt, "HomeTeam")
    -- Attack the opposite hoop
    if isHome then
        return Vector3.new(64.5, 9.9, -23.2)
    else
        return Vector3.new(-48.7, 12.5, -23.2)
    end
end

local function distToMyGoal()
    local root = myRoot()
    local g = goalPosition()
    if not root or not g then return 999 end
    return (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(g.X, 0, g.Z)).Magnitude
end

local function isInbounding(pkt)
    local act = pktAttr(pkt, "Action")
    return act == "Inbounding" or act == "Inbound" or pktAttr(pkt, "Inbounding") == true
end

local function looseBall(range)
    local bs = WS:FindFirstChild("Basketballs")
    if not bs then return nil end
    local root = myRoot()
    if not root then return nil end
    local best, bestD = nil, range or 120
    for _, b in ipairs(bs:GetDescendants()) do
        if b:IsA("BasePart") and b.Name:lower():find("ball") then
            local d = (b.Position - root.Position).Magnitude
            if d < bestD then best, bestD = b, d end
        end
    end
    return best
end

local function inCourt(pos)
    -- rough court bounds
    return pos.X > -80 and pos.X < 100 and pos.Z > -60 and pos.Z < 20
end

